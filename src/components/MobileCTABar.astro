---
// Sticky call / quote bar on phones.
import FileText from '@lucide/astro/icons/file-text';
import Phone from '@lucide/astro/icons/phone';
import { site } from '../config/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 px-3 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] shadow-[0_-10px_30px_-14px_rgb(16_42_67/0.35)] backdrop-blur md:hidden"
>
  <div class="grid grid-cols-2 gap-2.5">
    <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-13 px-3 text-[17px]" aria-label={`Call now on ${site.phone.display}`}>
      <Phone size={18} aria-hidden="true" /> Call Now
    </a>
    <a href={site.quoteUrl} class="btn-outline min-h-13 px-3 text-[17px]">
      <FileText size={18} aria-hidden="true" /> Get a Quote
    </a>
  </div>
</div>
