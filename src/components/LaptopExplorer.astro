---
/**
 * "Exploded laptop" explorer for the Laptop Repair page.
 * The laptop is drawn pulled apart into layers (screen, keyboard, motherboard, hard drive,
 * base + charger port). Clicking a layer (or its button) highlights it and shows that repair's
 * common signs - all text comes from the WordPress page via src/lib/laptop.ts.
 * Works without JavaScript too: the buttons are plain links to each repair's section.
 */
import AppWindow from '@lucide/astro/icons/app-window';
import ArrowDown from '@lucide/astro/icons/arrow-down';
import Bug from '@lucide/astro/icons/bug';
import Gauge from '@lucide/astro/icons/gauge';
import HeartPulse from '@lucide/astro/icons/heart-pulse';
import Laptop from '@lucide/astro/icons/laptop';
import Phone from '@lucide/astro/icons/phone';
import { site } from '../config/site';
import type { RepairSection } from '../lib/laptop';

interface Props {
  repairs: RepairSection[];
  extras: RepairSection[]; // non-hardware services (Tune Ups, Virus Removal, ...): shown on the screen
}
const { repairs, extras } = Astro.props;

// Which WordPress sections are physical parts of the laptop, top layer first
const PARTS = ['screenrepair', 'keyboard', 'motherbo', 'harddrive', 'dcjack'] as const;
const parts = PARTS.map((id) => repairs.find((r) => r.id === id)).filter((r): r is RepairSection => !!r);
const first = parts[0]?.id;
const extraIcon: Record<string, typeof Laptop> = {
  tuneup: Gauge,
  newlaptop: Laptop,
  virus: Bug,
  laptophealth: HeartPulse,
  laptopsoftware: AppWindow,
};
const all = [...parts, ...extras];

// --- isometric drawing helpers -------------------------------------------------------
const OX = 150;
const OY = 352;
const pt = (x: number, y: number, z: number) => `${(OX + (x - y) * 0.866).toFixed(1)},${(OY + (x + y) * 0.5 - z).toFixed(1)}`;
const quad = (a: number[], b: number[], c: number[], d: number[]) =>
  `M${pt(a[0], a[1], a[2])} L${pt(b[0], b[1], b[2])} L${pt(c[0], c[1], c[2])} L${pt(d[0], d[1], d[2])} Z`;
/** A box: top face, front (+y) face and right (+x) face */
const box = (x: number, y: number, z: number, w: number, d: number, h: number) => ({
  top: quad([x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]),
  front: quad([x, y + d, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x, y + d, z]),
  side: quad([x + w, y, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x + w, y, z]),
});
const line = (a: number[], b: number[]) => `M${pt(a[0], a[1], a[2])} L${pt(b[0], b[1], b[2])}`;

const W = 260;
const D = 160;
const GAP = 82;
const zOf: Record<string, number> = { screenrepair: GAP * 4, keyboard: GAP * 3, motherbo: GAP * 2, harddrive: GAP, dcjack: 0 };

// Screen layer
const zs = zOf.screenrepair;
const screen = box(0, 0, zs, W, D, 6);
const panel = quad([16, 16, zs + 6], [W - 16, 16, zs + 6], [W - 16, D - 16, zs + 6], [16, D - 16, zs + 6]);
const crack = [
  line([150, 70, zs + 6], [175, 100, zs + 6]),
  line([175, 100, zs + 6], [168, 130, zs + 6]),
  line([175, 100, zs + 6], [210, 112, zs + 6]),
  line([168, 130, zs + 6], [185, 140, zs + 6]),
].join(' ');

// Keyboard deck
const zk = zOf.keyboard;
const deck = box(0, 0, zk, W, D, 6);
const keyRows = [26, 42, 58, 74, 90].map((y) => line([24, y, zk + 6], [W - 24, y, zk + 6])).join(' ');
const pad = quad([100, 115, zk + 6], [160, 115, zk + 6], [160, 145, zk + 6], [100, 145, zk + 6]);

// Motherboard with chips and RAM
const zm = zOf.motherbo;
const board = box(15, 12, zm, 230, 136, 3);
const cpu = box(55, 40, zm + 3, 45, 45, 8);
const ram1 = box(140, 35, zm + 3, 80, 11, 10);
const ram2 = box(140, 55, zm + 3, 80, 11, 10);
const traces = [line([78, 85, zm + 3], [78, 130, zm + 3]), line([100, 62, zm + 3], [135, 62, zm + 3]), line([30, 62, zm + 3], [55, 62, zm + 3])].join(' ');

// Hard drive
const zh = zOf.harddrive;
const drive = box(150, 85, zh, 85, 60, 12);
const platter = `M${pt(192, 115, zh + 12)} m-14,0 a14,8 0 1,0 28,0 a14,8 0 1,0 -28,0`;

// Base with the charger (DC jack) port on the front edge
const base = box(0, 0, 0, W, D, 14);
const port = quad([30, D, 10], [62, D, 10], [62, D, 4], [30, D, 4]);
const feet = [line([20, D - 10, 0], [40, D - 10, 0]), line([W - 40, D - 10, 0], [W - 20, D - 10, 0])].join(' ');

const shapes: Record<string, string[]> = {
  screenrepair: [screen.front, screen.side, screen.top, panel, crack],
  keyboard: [deck.front, deck.side, deck.top, keyRows, pad],
  motherbo: [board.front, board.side, board.top, cpu.front, cpu.side, cpu.top, ram1.front, ram1.side, ram1.top, ram2.front, ram2.side, ram2.top, traces],
  harddrive: [drive.front, drive.side, drive.top, platter],
  dcjack: [base.front, base.side, base.top, port, feet],
};
// Centre of the screen, as a % of the drawing, for the software/care icon overlay
const [scx, scy] = pt(W / 2, D / 2, zs + 6).split(',').map(Number);
const screenX = `${((scx / 390) * 100).toFixed(2)}%`;
const screenY = `${((scy / 580) * 100).toFixed(2)}%`;

// Where each layer's label dot sits
const dot: Record<string, string> = {
  screenrepair: pt(W, 0, zs + 6),
  keyboard: pt(W, 0, zk + 6),
  motherbo: pt(245, 12, zm + 3),
  harddrive: pt(235, 85, zh + 12),
  dcjack: pt(46, D, 7),
};
---

<section class="relative isolate overflow-hidden bg-ink py-16 text-white sm:py-20" aria-labelledby="explorer-title" data-explorer>
  <!-- blueprint grid -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:32px_32px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-site">
    <p id="explorer-title" class="font-display text-3xl font-extrabold sm:text-4xl">Which part is playing up?</p>
    <p class="mt-3 max-w-xl text-lg text-white/70">Tap a part of the laptop to see the common signs and how we fix it.</p>

    <div class="mt-10 grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14">
      <!-- exploded laptop -->
      <div class="relative mx-auto w-full max-w-[300px] sm:max-w-[420px]" data-stage>
      <svg viewBox="0 0 390 580" class="w-full" fill="none" stroke-linejoin="round" stroke-linecap="round" role="presentation">
        {
          [...parts].reverse().map((p) => (
            <g class="layer cursor-pointer" data-part={p.id} tabindex="-1">
              {shapes[p.id].map((d, i) => (
                <path d={d} class:list={['layer-shape', i === 2 && 'layer-top']} />
              ))}
            </g>
          ))
        }
        {
          parts.map((p) => {
            const [cx, cy] = dot[p.id].split(',').map(Number);
            return (
              <g class="layer-dot pointer-events-none" data-part={p.id}>
                <circle cx={cx} cy={cy} r="7" />
                <circle cx={cx} cy={cy} r="14" class="ring" />
              </g>
            );
          })
        }
      </svg>
        {
          extras.map((e) => {
            const Icon = extraIcon[e.id] ?? Laptop;
            return (
              <span
                data-overlay={e.id}
                class="screen-icon pointer-events-none absolute grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-2xl bg-accent text-ink shadow-lift sm:size-20"
                style={`left:${screenX};top:${screenY}`}
                aria-hidden="true"
              >
                <Icon size={34} />
              </span>
            );
          })
        }
      </div>

      <div>
        <!-- part buttons -->
        <ul class="flex flex-wrap gap-2" role="list">
          {
            parts.map((p) => (
              <li>
                <a
                  href={`#${p.id}`}
                  data-pick={p.id}
                  aria-pressed={p.id === first ? 'true' : 'false'}
                  class="pick inline-flex rounded-full px-4 py-2 font-display text-sm font-bold ring-1 ring-white/20 transition hover:ring-accent aria-pressed:bg-accent aria-pressed:text-ink aria-pressed:ring-accent"
                >
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- one info panel per part; only the picked one shows -->
        {
          all.map((p) => (
            <div data-panel={p.id} hidden={p.id !== first} class="mt-6 rounded-2xl bg-white p-6 text-ink shadow-lift sm:p-7">
              {!parts.includes(p) && <p class="text-sm font-bold tracking-wide text-cta">Software &amp; care</p>}
              <p class="font-display text-2xl font-extrabold text-primary">{p.title ?? p.label}</p>
              {p.signs.length > 0 ? (
                <>
                  <p class="mt-4 text-sm font-bold tracking-wide text-slate-500">Common signs</p>
                  <ul class="mt-2 space-y-2">
                    {p.signs.map((s) => (
                      <li class="flex gap-2.5 text-[15px] leading-snug">
                        <span class="mt-1.5 size-2 shrink-0 rounded-full bg-cta" aria-hidden="true" />
                        <span set:html={s} />
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <div class="mt-3 text-[15px] leading-relaxed text-slate-600 [&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_a]:decoration-accent [&_a]:decoration-2 [&_a]:underline-offset-4" set:html={p.leadHtml} />
              )}
              <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
                <a href={`#${p.id}`} class="inline-flex items-center gap-1.5 font-display text-sm font-bold text-primary hover:underline">
                  How we fix it <ArrowDown size={16} aria-hidden="true" />
                </a>
                <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-11 px-5 text-sm">
                  <Phone size={16} aria-hidden="true" /> {site.phone.display}
                </a>
              </div>
            </div>
          ))
        }

        {
          extras.length > 0 && (
            <div class="mt-8">
              <p class="text-sm font-semibold text-white/60">Not a hardware problem?</p>
              <ul class="mt-3 flex flex-wrap gap-2" role="list">
                {extras.map((e) => (
                  <li>
                    <a
                      href={`#${e.id}`}
                      data-pick={e.id}
                      aria-pressed="false"
                      class="pick inline-flex rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white transition hover:bg-white hover:text-ink aria-pressed:bg-accent aria-pressed:text-ink"
                    >
                      {e.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  [data-explorer] .layer {
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [data-explorer] .layer-shape {
    stroke: rgb(255 255 255 / 0.45);
    stroke-width: 1.3;
    fill: color-mix(in oklab, var(--brand-ink), white 6%);
    transition: stroke 0.25s, fill 0.25s;
  }
  [data-explorer] .layer-top {
    fill: color-mix(in oklab, var(--brand-ink), white 10%);
  }
  [data-explorer] .layer:hover .layer-shape {
    stroke: rgb(255 255 255 / 0.8);
  }
  [data-explorer] .layer.is-active {
    transform: translateY(-10px);
  }
  [data-explorer] .layer.is-active .layer-shape {
    stroke: var(--brand-accent);
    stroke-width: 1.6;
    fill: color-mix(in oklab, var(--brand-ink), var(--brand-accent) 12%);
  }
  [data-explorer] .layer.is-active .layer-top {
    fill: color-mix(in oklab, var(--brand-ink), var(--brand-accent) 22%);
  }
  [data-explorer] .layer-dot circle {
    fill: var(--brand-accent);
    opacity: 0;
    transition: opacity 0.25s, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [data-explorer] .layer-dot .ring {
    fill: none;
    stroke: var(--brand-accent);
    stroke-width: 1.5;
  }
  [data-explorer] .layer-dot.is-active {
    transform: translateY(-10px);
  }
  [data-explorer] .layer-dot.is-active circle {
    opacity: 1;
  }
  [data-explorer] .layer-dot.is-active .ring {
    opacity: 0.5;
    animation: explorer-pulse 1.8s ease-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  [data-explorer] [data-stage].is-software .layer-shape {
    stroke: rgb(255 255 255 / 0.25);
  }
  [data-explorer] [data-stage].is-software .layer[data-part='screenrepair'] .layer-shape {
    stroke: var(--brand-accent);
  }
  [data-explorer] .screen-icon {
    opacity: 0;
    scale: 0.6;
    transition: opacity 0.25s, scale 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [data-explorer] .screen-icon.is-active {
    opacity: 1;
    scale: 1;
  }
  @keyframes explorer-pulse {
    from { transform: scale(0.6); opacity: 0.7; }
    to { transform: scale(1.5); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-explorer] .layer,
    [data-explorer] .layer-dot { transition: none; }
    [data-explorer] .layer-dot.is-active .ring { animation: none; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-explorer]')) {
    const select = (id: string) => {
      root.querySelectorAll<SVGGElement>('.layer, .layer-dot').forEach((g) => g.classList.toggle('is-active', g.dataset.part === id));
      root.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === id)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
      const overlays = root.querySelectorAll<HTMLElement>('[data-overlay]');
      overlays.forEach((o) => o.classList.toggle('is-active', o.dataset.overlay === id));
      root.querySelector('[data-stage]')?.classList.toggle('is-software', [...overlays].some((o) => o.dataset.overlay === id));
    };
    // Buttons: pick the part instead of jumping down (the panel has its own "How we fix it" link)
    root.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((b) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        select(b.dataset.pick!);
      }),
    );
    root.querySelectorAll<SVGGElement>('.layer').forEach((g) => g.addEventListener('click', () => select(g.dataset.part!)));
    const firstPick = root.querySelector<HTMLElement>('[data-pick]')?.dataset.pick;
    if (firstPick) select(firstPick);
  }
</script>
