---
/**
 * Dark "parts tray" for the Hardware Installation & Repair section of /pc-services-2/.
 * Left: the parts laid out on a technician's blueprint mat. Right: the WordPress list of common
 * hardware problems as a checklist. Pointing at (or tapping) a problem lights up its part, and
 * the other way round. While nobody is using it, it steps through the list on its own
 * (not with reduced motion). All text comes from the WordPress page via src/lib/pcservices.ts.
 */
import Check from '@lucide/astro/icons/check';
import Cpu from '@lucide/astro/icons/cpu';
import Disc3 from '@lucide/astro/icons/disc-3';
import FileText from '@lucide/astro/icons/file-text';
import HardDrive from '@lucide/astro/icons/hard-drive';
import Keyboard from '@lucide/astro/icons/keyboard';
import MemoryStick from '@lucide/astro/icons/memory-stick';
import Monitor from '@lucide/astro/icons/monitor';
import Network from '@lucide/astro/icons/network';
import Phone from '@lucide/astro/icons/phone';
import PlugZap from '@lucide/astro/icons/plug-zap';
import Thermometer from '@lucide/astro/icons/thermometer';
import Wrench from '@lucide/astro/icons/wrench';
import { site } from '../config/site';
import type { PcSection } from '../lib/pcservices';

interface Props {
  section: PcSection;
  number: string; // "04"
}
const { section, number } = Astro.props;

// Lead HTML holds the first paragraph and the "These common hardware problems include:" line
const leadParas = section.leadHtml.match(/<p>[\s\S]*?<\/p>/g) ?? [section.leadHtml];
const intro = leadParas.slice(0, -1).join('');
const listLead = leadParas.length > 1 ? leadParas.at(-1)! : '';

// The part drawn for each problem, matched on the problem's own words
const iconFor = (text: string) =>
  /monitor/i.test(text) ? Monitor
  : /overheat/i.test(text) ? Thermometer
  : /ram|memory/i.test(text) ? MemoryStick
  : /hard disk/i.test(text) ? HardDrive
  : /power/i.test(text) ? PlugZap
  : /cpu/i.test(text) ? Cpu
  : /disc/i.test(text) ? Disc3
  : /network/i.test(text) ? Network
  : /mice|keyboard|devices/i.test(text) ? Keyboard
  : Wrench;
const items = section.signs.map((html) => ({ html, Icon: iconFor(html.replace(/<[^>]+>/g, '')) }));
---

<section id={section.id} class="relative isolate scroll-mt-28 overflow-hidden bg-ink py-16 text-white sm:py-20 lg:py-24" aria-labelledby={`${section.id}-title`}>
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:32px_32px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 right-0 -z-10 size-[30rem] rounded-full bg-primary/40 blur-3xl" aria-hidden="true"></div>

  <div class="container-site" data-tray>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
      <div>
        <span class="inline-flex rounded-full bg-accent px-3 py-1 font-display text-sm font-extrabold text-ink">{number}</span>
        <h2 id={`${section.id}-title`} class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">{section.title}</h2>
        <span class="mt-4 block h-1 w-14 rounded-full bg-accent" aria-hidden="true"></span>
      </div>
      <div class="space-y-4 text-lg leading-relaxed text-white/75" set:html={intro} />
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10">
      <!-- the mat: one tile per part (decorative; the list on the right is the real content) -->
      <div class="relative mx-auto w-full max-w-[20rem] rounded-3xl bg-white/[0.04] p-4 ring-1 ring-white/10 sm:max-w-none sm:p-6">
        <div class="pointer-events-none absolute inset-3 rounded-2xl border-2 border-dashed border-white/10" aria-hidden="true"></div>
        <ul class="relative grid grid-cols-3 gap-3 sm:gap-4" aria-hidden="true">
          {
            items.map(({ Icon }, i) => (
              <li>
                <button type="button" tabindex="-1" data-hw={i} class="tray-tile group relative grid aspect-square w-full place-items-center overflow-hidden rounded-2xl bg-primary-deep/70 ring-1 ring-white/10 transition">
                  <span class="tray-scan pointer-events-none absolute inset-x-0 top-0 h-1/3" />
                  <Icon size={40} stroke-width={1.4} class="tray-icon relative text-white/70 transition sm:size-12" />
                  <span class="tray-badge absolute top-2 right-2 grid size-5 place-items-center rounded-full bg-accent text-ink opacity-0 transition">
                    <Check size={12} stroke-width={3.5} />
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- the checklist: WordPress words, one row per problem -->
      <div class="rounded-3xl bg-white p-6 text-ink shadow-panel sm:p-8">
        {listLead && <div class="font-display text-lg font-extrabold text-primary" set:html={listLead} />}
        <ul class="mt-4 space-y-1.5">
          {
            items.map(({ html, Icon }, i) => (
              <li>
                <button type="button" data-hw={i} class="tray-row flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left text-[15px] leading-snug transition">
                  <span class="tray-check mt-0.5 grid size-5 shrink-0 place-items-center rounded bg-accent text-ink">
                    <Check size={13} stroke-width={3.5} aria-hidden="true" />
                  </span>
                  <span class="min-w-0 flex-1" set:html={html} />
                  <Icon size={18} class="tray-row-icon mt-0.5 shrink-0 text-slate-300 transition" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      section.restHtml && (
        <div class="mt-10 flex flex-col gap-6 rounded-3xl bg-white/[0.06] p-6 ring-1 ring-white/10 sm:p-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl space-y-4 text-lg leading-relaxed text-white/85" set:html={section.restHtml} />
          <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
            <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-13 px-6">
              <Phone size={18} aria-hidden="true" /> Call {site.phone.display}
            </a>
            <a href={site.quoteUrl} class="btn-outline-light min-h-13 px-6">
              <FileText size={18} aria-hidden="true" /> Get a Quote
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .tray-tile.is-on {
    background: color-mix(in oklab, var(--brand-accent), transparent 86%);
    box-shadow: 0 0 0 2px var(--brand-accent), 0 0 28px -4px color-mix(in oklab, var(--brand-accent), transparent 40%);
    transform: translateY(-2px);
  }
  .tray-tile.is-on .tray-icon {
    color: var(--brand-accent);
  }
  .tray-tile.is-on .tray-badge {
    opacity: 1;
  }
  .tray-scan {
    opacity: 0;
    background: linear-gradient(to bottom, transparent, color-mix(in oklab, var(--brand-accent), transparent 70%) 85%, var(--brand-accent));
  }
  .tray-tile.is-on .tray-scan {
    animation: tray-scan 1.4s ease-in-out infinite;
  }
  @keyframes tray-scan {
    0% { transform: translateY(-100%); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(300%); opacity: 0; }
  }
  .tray-row:hover,
  .tray-row.is-on {
    background: color-mix(in oklab, var(--brand-primary), white 93%);
    box-shadow: inset 3px 0 0 var(--brand-accent);
  }
  .tray-row.is-on .tray-row-icon {
    color: var(--brand-primary);
  }
  @media (prefers-reduced-motion: reduce) {
    .tray-tile,
    .tray-row {
      transition: none;
    }
    .tray-tile.is-on {
      transform: none;
    }
    .tray-tile.is-on .tray-scan {
      animation: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tray]')) {
    const all = [...root.querySelectorAll<HTMLElement>('[data-hw]')];
    const count = root.querySelectorAll('.tray-row').length;
    let current = 0;
    const select = (i: number) => {
      current = i;
      all.forEach((el) => el.classList.toggle('is-on', Number(el.dataset.hw) === i));
    };
    select(0);

    // Step through the list on its own until someone points at or taps it
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = calm || count < 2 ? 0 : window.setInterval(() => select((current + 1) % count), 2600);
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };
    for (const el of all) {
      const pick = () => {
        stop();
        select(Number(el.dataset.hw));
      };
      el.addEventListener('mouseenter', pick);
      el.addEventListener('focus', pick);
      el.addEventListener('click', pick);
    }
  }
</script>
