---
// Blog posts (127)
// Not designed yet - plain layout. Keep <slot /> (the original text) as it is.
interface Props {
  data: { title: string };
  heading: string; // the page's single H1 (same words as the WordPress page)
}
const { heading } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <h1 class="mb-6 text-3xl font-bold">{heading}</h1>
  <article class="prose max-w-none">
    <slot />
  </article>
</section>
