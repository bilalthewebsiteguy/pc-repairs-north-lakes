---
// Main header. Menu items and URLs come from site.nav, which matches the WordPress menu
// so internal links stay the same. White sticky header in the North Lakes brand.
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Menu from '@lucide/astro/icons/menu';
import Phone from '@lucide/astro/icons/phone';
import X from '@lucide/astro/icons/x';
import { site, type NavItem } from '../config/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const nav = site.nav as readonly NavItem[];
const isActive = (item: NavItem) =>
  item.href === '/' ? path === '/' : path === item.href || (item.children ?? []).some((c) => c.href === path);

// Active page gets a yellow underline bar
const navLink =
  "relative px-3 py-2 font-display text-[15px] font-semibold text-ink/80 transition hover:text-primary after:absolute after:inset-x-3 after:-bottom-[23px] after:h-[3px] after:rounded-full after:bg-accent after:opacity-0 after:content-[''] aria-[current=page]:text-primary aria-[current=page]:after:opacity-100";
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-site flex h-[68px] items-center justify-between gap-4 lg:h-[76px]">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) =>
            item.children ? (
              <li class="group relative" data-dropdown>
                <div class="flex items-center">
                  <a href={item.href} class={navLink} aria-current={isActive(item) ? 'page' : undefined}>
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="-ml-2 grid size-8 place-items-center text-ink/50 hover:text-primary"
                    aria-expanded="false"
                    aria-controls="services-menu"
                    data-dropdown-toggle
                  >
                    <span class="sr-only">Show {item.label.toLowerCase()} menu</span>
                    <ChevronDown size={16} class="transition group-hover:rotate-180 group-data-open:rotate-180" aria-hidden="true" />
                  </button>
                </div>
                <div
                  id="services-menu"
                  class="invisible absolute top-full left-0 w-72 translate-y-1 pt-[22px] opacity-0 transition duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-data-open:visible group-data-open:translate-y-0 group-data-open:opacity-100"
                >
                  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-panel">
                    <ul class="divide-y divide-slate-100">
                      {item.children.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            class="flex items-center justify-between px-4 py-3.5 font-display text-sm font-semibold text-ink transition hover:bg-primary-tint hover:text-primary aria-[current=page]:bg-primary-tint aria-[current=page]:text-primary aria-[current=page]:shadow-[inset_3px_0_0_var(--brand-accent)]"
                            aria-current={path === c.href ? 'page' : undefined}
                          >
                            {c.label}
                            <ArrowRight size={15} class="text-slate-400" aria-hidden="true" />
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href={item.href} class="flex items-center justify-between bg-primary-tint px-4 py-3 font-display text-sm font-bold text-primary hover:bg-primary-soft">
                      View all services <ArrowRight size={16} aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class={navLink} aria-current={isActive(item) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a href={site.quoteUrl} class="btn-outline hidden min-h-11 px-4 xl:inline-flex">Get a Quote</a>
      <a href={`tel:${site.phone.tel}`} class="btn-cta hidden min-h-11 px-4 sm:inline-flex">
        <Phone size={17} aria-hidden="true" /> {site.phone.display}
      </a>
      <a
        href={`tel:${site.phone.tel}`}
        class="grid size-11 place-items-center rounded-lg bg-cta text-white sm:hidden"
        aria-label={`Call ${site.phone.display}`}
      >
        <Phone size={20} aria-hidden="true" />
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-lg border border-slate-300 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <Menu size={22} aria-hidden="true" data-icon-open />
        <X size={22} aria-hidden="true" class="hidden" data-icon-close />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="h-[calc(100dvh-68px)] overflow-y-auto overscroll-contain border-t border-slate-200 bg-white lg:hidden" hidden>
    <nav aria-label="Mobile" class="container-site flex min-h-full flex-col py-3">
      <ul class="divide-y divide-slate-200">
        {
          nav.map((item) =>
            item.children ? (
              <li>
                <details class="group" open={isActive(item)}>
                  <summary
                    class:list={[
                      'flex cursor-pointer list-none items-center justify-between py-4 font-display text-lg font-bold',
                      isActive(item) ? 'text-primary' : 'text-ink',
                    ]}
                  >
                    {item.label}
                    <ChevronDown size={20} class="text-primary transition group-open:rotate-180" aria-hidden="true" />
                  </summary>
                  <ul class="mb-3 grid gap-1">
                    {item.children.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          class="flex items-center rounded-md px-2 py-2.5 text-slate-700 hover:bg-primary-tint hover:text-primary aria-[current=page]:bg-primary-tint aria-[current=page]:font-bold aria-[current=page]:text-primary"
                          aria-current={path === c.href ? 'page' : undefined}
                        >
                          {c.label}
                        </a>
                      </li>
                    ))}
                    <li>
                      <a href={item.href} class="flex items-center gap-2 px-2 py-2.5 text-sm font-bold text-primary">
                        All services <ArrowRight size={15} aria-hidden="true" />
                      </a>
                    </li>
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="flex items-center justify-between py-4 font-display text-lg font-bold text-ink aria-[current=page]:text-primary"
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  {item.label}
                  <ArrowRight size={18} class="text-slate-400" aria-hidden="true" />
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="mt-auto grid gap-3 pt-6 pb-24">
        <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-14 text-lg">
          <Phone size={19} aria-hidden="true" /> Call {site.phone.display}
        </a>
        <a href={site.quoteUrl} class="btn-outline min-h-14 text-lg">Get a Free Quote</a>
        <p class="pt-2 text-center text-sm text-slate-500">Same-day service · {site.area}</p>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu (full-height panel, locks page scroll while open)
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      const label = toggle.querySelector('[data-menu-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    toggle.addEventListener('click', () => setOpen(Boolean(menu.hidden)));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }

  // Desktop dropdown (also opens on hover / focus via CSS)
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!btn) return;
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      item.toggleAttribute('data-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        btn.focus();
      }
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) setOpen(false);
    });
  });
</script>
