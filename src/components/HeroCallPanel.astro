---
// Homepage hero side panel - a modern take on the old site's steel-blue
// "CALL 07 3144 6766 / Servicing Moreton Bay and Brisbane Northside" bar.
import Check from '@lucide/astro/icons/check';
import Phone from '@lucide/astro/icons/phone';
import { site } from '../config/site';

const points = ['Same-day service', 'Laptop, PC & Mac repairs', 'Home & business call-outs'];
---

<div class="relative overflow-hidden rounded-2xl bg-primary p-7 text-white shadow-lift sm:p-8">
  <div class="pointer-events-none absolute -top-16 -right-16 size-48 rounded-full bg-white/10" aria-hidden="true"></div>
  <p class="font-display text-sm font-bold tracking-[0.14em] text-accent uppercase">Talk to a technician</p>
  <a href={`tel:${site.phone.tel}`} class="mt-3 flex items-center gap-3 font-display text-3xl font-extrabold text-white hover:underline sm:text-4xl">
    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-cta"><Phone size={20} aria-hidden="true" /></span>
    {site.phone.display}
  </a>
  <ul class="mt-6 space-y-3 border-t border-white/15 pt-6">
    {
      points.map((p) => (
        <li class="flex items-center gap-3 font-semibold">
          <span class="grid size-6 shrink-0 place-items-center rounded-full bg-accent text-ink">
            <Check size={14} stroke-width={3.5} aria-hidden="true" />
          </span>
          {p}
        </li>
      ))
    }
  </ul>
</div>
