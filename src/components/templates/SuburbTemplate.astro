---
// Suburb pages: /computer-repairs-<suburb>/  (95 pages share this template).
// The page text (<slot />) is the exported WordPress text, unchanged - only its look is styled.
import CtaBand from '../CtaBand.astro';
import PageHero from '../PageHero.astro';
import Prose from '../Prose.astro';
import SideCallCard from '../SideCallCard.astro';

interface Props {
  data: { title: string };
  heading: string; // the page's single H1 (same words as the WordPress page)
}
const { data, heading } = Astro.props;
const suburb = data.title.replace(/^computer repairs\s*/i, '').trim() || data.title;
---

<PageHero title={heading} eyebrow={`Same-day service · ${suburb}`} />

<section class="section">
  <div class="container-site grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
    <Prose>
      <slot />
    </Prose>
    <div>
      <SideCallCard heading={`Need a technician in ${suburb}?`} />
    </div>
  </div>
</section>

<CtaBand title={`Computer problems in ${suburb}? Let’s get it sorted.`} />
