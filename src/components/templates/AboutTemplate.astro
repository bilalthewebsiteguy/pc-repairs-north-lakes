---
// About page (/about-us/). Same words as WordPress (split by src/lib/about.ts).
// Laid out as: pegboard hero (its staff badges are the WordPress team list), the About Us headings
// with the intro as a statement, then a dark band with the Email / Phone cards and a coverage card.
// The WordPress contact form ([fluentform id="1"]) did not export and is not shown - ask Bilal.
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import Copy from '@lucide/astro/icons/copy';
import FileText from '@lucide/astro/icons/file-text';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Wrench from '@lucide/astro/icons/wrench';
import CtaBand from '../CtaBand.astro';
import HeroPegboard from '../HeroPegboard.astro';
import { site } from '../../config/site';
import { aboutSections } from '../../lib/about';

interface Props {
  heading: string; // the page's single H1 (same words as the WordPress page)
  body: string; // raw exported markdown of the page
}
const { heading, body } = Astro.props;
const p = await aboutSections(body);

// Quick facts for the hero, quoted word for word from the page text (dropped if not found)
const facts = ['our professional technicians', 'we’ll attend to your concerns as soon as possible'].filter((f) => p.introText.includes(f));

// Coverage card: the menu's own "Coverage Areas" item (label + link), with site.area underneath
const coverage = site.nav.find((n) => n.href === '/areas-we-serve/');

const linkStyle =
  '[&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_a]:decoration-accent [&_a]:decoration-2 [&_a]:underline-offset-4';
---

<!-- Hero: blueprint grid + the pegboard tool wall with the team's staff badges -->
<section class="relative isolate overflow-hidden bg-primary text-white">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.09] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:36px_36px] [mask-image:linear-gradient(to_right,transparent,black_45%)]"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute -bottom-48 -left-40 -z-10 size-[34rem] rounded-full bg-white/[0.05] blur-3xl" aria-hidden="true"></div>
  <div class="container-site grid grid-cols-1 items-center gap-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10 lg:py-16">
    <div class="lg:-translate-y-6">
      <h1 class="font-display text-[2.5rem] leading-[1.02] font-extrabold tracking-[-0.02em] text-white sm:text-6xl xl:text-[4.1rem]">
        {heading}
      </h1>
      <p class="mt-6 max-w-xl text-xl text-white/85">Servicing {site.area}</p>
      {
        facts.length > 0 && (
          <ul class="mt-7 space-y-2.5" role="list">
            {facts.map((f) => (
              <li class="flex items-center gap-3 text-lg text-white/90">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-accent text-ink">
                  <Check size={14} stroke-width={3.5} aria-hidden="true" />
                </span>
                <span class="first-letter:uppercase">{f}</span>
              </li>
            ))}
          </ul>
        )
      }
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-13 px-6 text-base sm:text-lg">
          <Phone size={19} aria-hidden="true" /> Call {site.phone.display}
        </a>
        <a href={site.quoteUrl} class="btn-outline-light min-h-13 px-6 text-base sm:text-lg">
          <FileText size={18} aria-hidden="true" /> Get a Quote
        </a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[560px] lg:max-w-none">
      <HeroPegboard team={p.team} brand={p.brand?.title} />
    </div>
  </div>
</section>

<!-- About Us + contact as ONE "repair docket": the About text on the ticket, Email / Phone / coverage
     on the tear-off stub, with a perforated line between them -->
<section class="section relative isolate overflow-hidden bg-primary-tint">
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.5] [background-image:radial-gradient(color-mix(in_oklab,var(--brand-primary),transparent_80%)_1.2px,transparent_1.2px)] [background-size:22px_22px]" aria-hidden="true"></div>
  <Wrench size={300} stroke-width={1} class="pointer-events-none absolute -bottom-24 -left-20 -z-10 -rotate-12 text-primary/[0.05]" aria-hidden="true" />

  <div class="container-site">
    <div class="docket relative mx-auto max-w-5xl">
      <!-- gold clip holding the docket -->
      <span class="absolute -top-4 left-1/2 z-20 h-8 w-24 -translate-x-1/2 rounded-b-xl rounded-t-md bg-accent shadow-lift ring-4 ring-primary-tint lg:left-[34%]" aria-hidden="true">
        <span class="absolute top-2 left-1/2 h-1.5 w-12 -translate-x-1/2 rounded-full bg-ink/25" />
      </span>

      <div class="relative grid grid-cols-1 overflow-hidden rounded-3xl shadow-panel lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
        <!-- the ticket: About Us -->
        <div class="relative bg-white p-7 pt-10 sm:p-10 sm:pt-12">
          {p.aboutUs && <h2 id={p.aboutUs.id} class="text-4xl font-extrabold text-primary sm:text-5xl">{p.aboutUs.title}</h2>}
          {
            p.brand && (
              <h2 id={p.brand.id} class="mt-4 inline-flex items-center gap-3 rounded-full bg-primary-tint py-2 pr-5 pl-2 font-display text-lg font-extrabold text-ink ring-1 ring-slate-200 sm:text-xl">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent text-ink">
                  <Wrench size={17} aria-hidden="true" />
                </span>
                {p.brand.title}
              </h2>
            )
          }
          <div class="relative mt-8 pl-6">
            <span class="absolute top-1 bottom-1 left-0 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            <div class:list={['font-display text-lg leading-snug font-bold text-ink sm:text-[1.35rem] sm:leading-snug', linkStyle]} set:html={p.introHtml} />
          </div>
          <!-- ruled "notes" lines at the foot of the ticket -->
          <span class="mt-10 block space-y-3" aria-hidden="true">
            <span class="block h-px bg-slate-200" />
            <span class="block h-px w-3/4 bg-slate-200" />
          </span>
        </div>

        <!-- the tear-off stub: Email / Phone / coverage -->
        <div class="relative isolate bg-primary p-7 text-white sm:p-9">
          <!-- the perforation along the stub's edge: gold dashes + half-circle notches (across on mobile, down on desktop) -->
          <span class="perf" aria-hidden="true"></span>
          <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.08] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:22px_22px]" aria-hidden="true"></div>
          <ul class="divide-y divide-dashed divide-white/20">
            {
              p.email && (
                <li class="pb-6">
                  <div class="flex items-center gap-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent text-ink">
                      <Mail size={19} aria-hidden="true" />
                    </span>
                    <h2 id={p.email.id} class="text-xl font-extrabold text-white">{p.email.title}</h2>
                    {p.email.href?.startsWith('mailto:') && (
                      <button type="button" data-copy={p.email.href.replace(/^mailto:/, '')} class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-bold text-white ring-1 ring-white/20 transition hover:bg-white hover:text-primary">
                        <Copy size={13} aria-hidden="true" data-copy-icon />
                        <Check size={13} class="hidden" aria-hidden="true" data-copied-icon />
                        <span data-copy-label>Copy</span>
                      </button>
                    )}
                  </div>
                  <div class="contact-link mt-3 font-display text-[15px] font-bold whitespace-nowrap text-white max-[380px]:text-[13.5px] max-[340px]:whitespace-normal sm:text-base" set:html={p.email.html.replace(/>([^<@]+)@/, (_m, a) => `>${a}@<wbr>`)} />
                </li>
              )
            }
            {
              p.phone && (
                <li class="py-6">
                  <div class="flex items-center gap-3">
                    <span class="phone-ring relative grid size-10 shrink-0 place-items-center rounded-xl bg-cta text-white">
                      <Phone size={19} aria-hidden="true" />
                    </span>
                    <h2 id={p.phone.id} class="text-xl font-extrabold text-white">{p.phone.title}</h2>
                  </div>
                  <div class="contact-link mt-3 font-display text-3xl font-extrabold text-white" set:html={p.phone.html} />
                </li>
              )
            }
            {
              coverage && (
                <li class="pt-6">
                  <a href={coverage.href} class="group flex items-center gap-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white/15 text-accent">
                      <MapPin size={19} aria-hidden="true" />
                    </span>
                    <span class="min-w-0">
                      <span class="block font-display text-base font-extrabold text-white group-hover:text-accent">{coverage.label}</span>
                      <span class="block text-sm text-white/70">{site.area}</span>
                    </span>
                    <ArrowRight size={18} class="ml-auto shrink-0 text-accent transition group-hover:translate-x-1" aria-hidden="true" />
                  </a>
                </li>
              )
            }
          </ul>
          <!-- barcode at the foot of the stub -->
          <span class="mt-7 flex h-9 items-stretch gap-[3px] opacity-70" aria-hidden="true">
            {[3, 1, 2, 1, 4, 1, 1, 2, 3, 1, 2, 4, 1, 1, 3, 2, 1, 2, 1, 3, 1, 4, 2, 1, 1, 3].map((w) => (
              <span class="bg-white" style={`width:${w}px`} />
            ))}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<CtaBand />

<style>
  /* the docket sits slightly tilted on desktop and straightens on hover */
  @media (min-width: 64rem) {
    .docket {
      rotate: -1deg;
      transition: rotate 0.4s ease;
    }
    .docket:hover {
      rotate: 0deg;
    }
  }
  /* perforation: on mobile it runs across the top of the stub, on desktop down its left edge */
  .perf {
    position: absolute;
    z-index: 10;
    pointer-events: none;
    inset: 0 0 auto 0;
    border-top: 2px dashed var(--brand-accent);
  }
  .perf::before,
  .perf::after {
    content: "";
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    background: var(--color-primary-tint, color-mix(in oklab, var(--brand-primary), white 95%));
    top: -18px;
  }
  .perf::before { left: -17px; }
  .perf::after { right: -17px; }
  @media (min-width: 64rem) {
    .perf {
      inset: 0 auto 0 0;
      border-top: 0;
      border-left: 2px dashed var(--brand-accent);
    }
    .perf::before,
    .perf::after {
      left: -18px;
      right: auto;
    }
    .perf::before { top: -17px; }
    .perf::after { top: auto; bottom: -17px; }
  }
  /* links inside the contact cards: white, underlined in gold on hover */
  .contact-link :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s;
  }
  .contact-link :global(a:hover) {
    text-decoration-color: var(--brand-accent);
  }
  /* phone icon: a soft ring pulses out from it */
  .phone-ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.6);
    animation: phone-ring 2s ease-out infinite;
  }
  @keyframes phone-ring {
    to { box-shadow: 0 0 0 14px rgb(255 255 255 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone-ring::after {
      animation: none;
    }
  }
</style>

<script>
  // "Copy" button on the email card
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
      } catch {
        return;
      }
      const label = btn.querySelector('[data-copy-label]');
      btn.querySelector('[data-copy-icon]')?.classList.add('hidden');
      btn.querySelector('[data-copied-icon]')?.classList.remove('hidden');
      if (label) label.textContent = 'Copied';
      setTimeout(() => {
        btn.querySelector('[data-copy-icon]')?.classList.remove('hidden');
        btn.querySelector('[data-copied-icon]')?.classList.add('hidden');
        if (label) label.textContent = 'Copy';
      }, 2000);
    });
  }
</script>
