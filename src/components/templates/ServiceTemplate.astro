---
// Service pages and general pages (Laptop Repair, Mac Repair, Services, About, brand pages, ...).
// The page text (<slot />) is the exported WordPress text, unchanged - only its look is styled.
import CtaBand from '../CtaBand.astro';
import PageHero from '../PageHero.astro';
import Prose from '../Prose.astro';
import SideCallCard from '../SideCallCard.astro';

interface Props {
  data: { title: string };
  heading: string; // the page's single H1 (same words as the WordPress page)
}
const { heading } = Astro.props;
---

<PageHero title={heading} eyebrow="Our services" />

<section class="section">
  <div class="container-site grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
    <Prose>
      <slot />
    </Prose>
    <div>
      <SideCallCard heading="Talk to a local technician" />
    </div>
  </div>
</section>

<CtaBand />
