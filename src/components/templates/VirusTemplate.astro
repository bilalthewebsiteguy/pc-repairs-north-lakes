---
// Virus and Spyware Removal page (/virus-and-spyware-removal/). Same words as WordPress, split by
// src/lib/virus.ts (nothing typed here except a few short UI labels: step names, "More questions", search).
// Layout:
//   1. Hero: shield scanner (HeroVirusShield). The long H1 = big title + smaller line, one <h1>.
//   2. Intro + Key Takeaways as coloured bento tiles, next to the side call card.
//   3. Understanding Cyber Threats (dark-topped dossier card) + Choosing the Right Antivirus
//      (question bubble + icon rows).
//   4. Daily Security Practices: a timeline.
//   5. Recognizing Infection Symptoms: an "infected browser" drawing + warning cards.
//   6. Dark blueprint: Comprehensive Removal Process as a clickable "removal console" (step by step).
//      All steps are in the HTML; without JS they all show.
//   7. Maintaining Ongoing Protection: three shield tiles.
//   8. FAQ: the 4 WordPress questions (h3) as an accordion, then the 28 numbered questions as a
//      searchable accordion grid.
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import AppWindow from '@lucide/astro/icons/app-window';
import Bug from '@lucide/astro/icons/bug';
import Check from '@lucide/astro/icons/check';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import FileText from '@lucide/astro/icons/file-text';
import Gauge from '@lucide/astro/icons/gauge';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Hammer from '@lucide/astro/icons/hammer';
import Lock from '@lucide/astro/icons/lock';
import MailExclamationPoint from '@lucide/astro/icons/mail-exclamation-point';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';
import Phone from '@lucide/astro/icons/phone';
import Plus from '@lucide/astro/icons/plus';
import Radar from '@lucide/astro/icons/radar';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import Scale from '@lucide/astro/icons/scale';
import ScanSearch from '@lucide/astro/icons/scan-search';
import Search from '@lucide/astro/icons/search';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import ShieldQuestionMark from '@lucide/astro/icons/shield-question-mark';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import Sparkles from '@lucide/astro/icons/sparkles';
import TriangleExclamationPoint from '@lucide/astro/icons/triangle-exclamation-point';
import Usb from '@lucide/astro/icons/usb';
import Activity from '@lucide/astro/icons/activity';
import CtaBand from '../CtaBand.astro';
import HeroVirusShield from '../HeroVirusShield.astro';
import InfectedScreen from '../InfectedScreen.astro';
import SideCallCard from '../SideCallCard.astro';
import { site } from '../../config/site';
import { heroFacts, splitHeading, virusSections } from '../../lib/virus';

interface Props {
  heading: string; // the page's single H1 (same words as the WordPress page)
  body: string; // raw exported markdown of the page
}
const { heading, body } = Astro.props;
const h = splitHeading(heading);
const facts = heroFacts(body);
const p = await virusSections(body);

const tones = ['bg-primary text-white', 'bg-accent text-ink', 'bg-cta text-white'];
const tone = (i: number) => tones[i % tones.length];
const linkStyle =
  '[&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_a]:decoration-accent [&_a]:decoration-2 [&_a]:underline-offset-4';
const titleCls = 'font-display text-3xl font-extrabold text-primary sm:text-4xl';
const gridBg =
  'pointer-events-none absolute inset-0 -z-10 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:36px_36px]';

// Key Takeaways: bento tiles (wide, narrow, narrow, wide)
const ktTiles = [
  { Icon: Bug, cls: 'bg-primary text-white sm:col-span-3', chip: 'bg-accent text-ink' },
  { Icon: SlidersHorizontal, cls: 'bg-accent-soft text-ink ring-1 ring-accent/40 sm:col-span-2', chip: 'bg-primary text-white' },
  { Icon: TriangleExclamationPoint, cls: 'bg-cta text-white sm:col-span-2', chip: 'bg-white text-cta' },
  { Icon: Sparkles, cls: 'bg-ink text-white sm:col-span-3', chip: 'bg-accent text-ink' },
];

// Choosing the Right Antivirus: first paragraph is a question -> bubble; the rest -> icon rows
const avIcons = [Radar, Gauge, MousePointerClick, Scale];
const dailyIcons = [SlidersHorizontal, ScanSearch, Usb, GraduationCap];
const symptomIcons = [Activity, AppWindow, Lock];

// Removal process: paragraph 1 = lead, the rest = console steps (short UI labels, only if there are 4)
const removalLead = p.removal?.paras[0] ?? '';
const removalSteps = p.removal?.paras.slice(1) ?? [];
const stepLabels = removalSteps.length === 4 ? ['Scan', 'Remove', 'Repair', 'Fortify'] : removalSteps.map((_, i) => `Step ${i + 1}`);
const stepIcons = [ScanSearch, Bug, Hammer, ShieldCheck];
const pad = (n: number) => String(n).padStart(2, '0');

// FAQ: strip <p> wrappers for questions that came through md()
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
---

<!-- 1. Hero: blueprint grid + the shield scanner -->
<section class="relative isolate overflow-hidden bg-primary text-white">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.09] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:36px_36px] [mask-image:linear-gradient(to_right,transparent,black_45%)]"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute -top-40 -left-40 -z-10 size-[34rem] rounded-full bg-cta/[0.10] blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-32 -bottom-48 -z-10 size-[30rem] rounded-full bg-accent/[0.10] blur-3xl" aria-hidden="true"></div>

  <div class="container-site grid grid-cols-1 items-center gap-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10 lg:py-16">
    <div>
      <h1 class="font-display font-extrabold text-white">
        <span class="block text-[2.5rem] leading-[1.02] tracking-[-0.02em] sm:text-6xl xl:text-[4.1rem]">{h.title}</span>{' '}
        {
          h.rest && (
            <span class="mt-5 flex max-w-xl gap-3 text-lg leading-snug font-bold tracking-normal text-white/85 sm:text-xl">
              <span class="text-accent">{h.dash}</span> <span>{h.rest}</span>
            </span>
          )
        }
      </h1>

      {
        facts.length > 0 && (
          <ul class="mt-7 space-y-2.5" role="list">
            {facts.map((f) => (
              <li class="flex items-center gap-3 text-lg text-white/90">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-accent text-ink">
                  <Check size={14} stroke-width={3.5} aria-hidden="true" />
                </span>
                <span class="first-letter:uppercase">{f}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-13 px-6 text-base sm:text-lg">
          <Phone size={19} aria-hidden="true" /> Call {site.phone.display}
        </a>
        <a href={site.quoteUrl} class="btn-outline-light min-h-13 px-6 text-base sm:text-lg">
          <FileText size={18} aria-hidden="true" /> Get a Quote
        </a>
      </div>
    </div>
    <div class="w-full">
      <HeroVirusShield />
    </div>
  </div>
</section>

<!-- 2. Intro + Key Takeaways, next to the side call card -->
<section class="section relative isolate overflow-hidden bg-white">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background-image:radial-gradient(color-mix(in_oklab,var(--brand-primary),transparent_82%)_1.2px,transparent_1.2px)] [background-size:22px_22px] [mask-image:linear-gradient(to_left,black,transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div class="container-site grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-12">
    <div class="min-w-0">
      {
        p.intro.length > 0 && (
          <div class="relative pl-6">
            <span class="absolute top-1 bottom-1 left-0 w-1.5 rounded-full bg-accent" aria-hidden="true" />
            <div
              class:list={[
                'space-y-5 text-lg leading-relaxed text-slate-700 [&>p:first-child]:text-xl [&>p:first-child]:leading-relaxed [&>p:first-child]:font-semibold [&>p:first-child]:text-ink',
                linkStyle,
              ]}
              set:html={p.intro.join('')}
            />
          </div>
        )
      }

      {
        p.takeaways && (
          <div class="mt-14">
            <h2 id={p.takeaways.id} class={titleCls}>
              {p.takeaways.title}
            </h2>
            <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-5" role="list">
              {p.takeaways.items.map((html, i) => {
                const t = ktTiles[i % ktTiles.length];
                return (
                  <li class:list={['relative isolate overflow-hidden rounded-3xl p-6 transition hover:-translate-y-0.5 hover:shadow-lift sm:p-7', t.cls]}>
                    <t.Icon size={130} stroke-width={1.25} class="pointer-events-none absolute -right-6 -bottom-8 -z-10 opacity-[0.09]" aria-hidden="true" />
                    <div class="flex items-center justify-between">
                      <span class:list={['grid size-12 place-items-center rounded-xl', t.chip]}>
                        <t.Icon size={22} aria-hidden="true" />
                      </span>
                      <span class="font-display text-sm font-extrabold tabular-nums opacity-60">{pad(i + 1)}</span>
                    </div>
                    <div class="mt-5 text-[17px] leading-relaxed font-semibold [&_p]:m-0" set:html={html} />
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }
    </div>
    <div class="lg:self-start">
      <SideCallCard heading="Talk to a local technician" />
    </div>
  </div>
</section>

<!-- 3. Understanding Cyber Threats + Choosing the Right Antivirus -->
{
  (p.cyber || p.antivirus) && (
    <section class="section bg-primary-tint">
      <div class="container-site grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10">
        {p.cyber && (
          <article class="overflow-hidden rounded-3xl bg-white shadow-lift ring-1 ring-slate-200 lg:self-start">
            <div class="relative isolate overflow-hidden bg-ink px-6 py-8 text-white sm:px-8">
              <div class={gridBg} aria-hidden="true" />
              <Bug size={150} stroke-width={1.1} class="pointer-events-none absolute -top-6 -right-6 -z-10 text-white/[0.07]" aria-hidden="true" />
              <div class="flex gap-2" aria-hidden="true">
                <span class="grid size-10 place-items-center rounded-xl bg-cta text-white">
                  <Bug size={19} />
                </span>
                <span class="grid size-10 place-items-center rounded-xl bg-accent text-ink">
                  <TriangleExclamationPoint size={19} />
                </span>
                <span class="grid size-10 place-items-center rounded-xl bg-primary text-white">
                  <ShieldCheck size={19} />
                </span>
              </div>
              <h2 id={p.cyber.id} class="mt-5 font-display text-3xl font-extrabold text-white sm:text-4xl">
                {p.cyber.title}
              </h2>
            </div>
            <div class="space-y-5 p-6 text-[17px] leading-relaxed text-slate-700 sm:p-8">
              {p.cyber.paras.map((html, i) => (
                <div class="flex gap-4">
                  <span class:list={['mt-2 h-2.5 w-2.5 shrink-0 rounded-full', ['bg-cta', 'bg-accent', 'bg-primary'][i % 3]]} aria-hidden="true" />
                  <div class:list={['[&_p]:m-0', linkStyle]} set:html={html} />
                </div>
              ))}
            </div>
          </article>
        )}

        {p.antivirus && (
          <div>
            <h2 id={p.antivirus.id} class={titleCls}>
              {p.antivirus.title}
            </h2>
            {p.antivirus.paras[0] && (
              <div class="relative isolate mt-7 overflow-hidden rounded-3xl rounded-bl-md bg-primary p-6 text-white shadow-lift sm:p-7">
                <ShieldQuestionMark size={120} stroke-width={1.2} class="pointer-events-none absolute -right-4 -bottom-6 -z-10 text-white/[0.08]" aria-hidden="true" />
                <span class="grid size-11 place-items-center rounded-xl bg-accent text-ink">
                  <ShieldQuestionMark size={21} aria-hidden="true" />
                </span>
                <div class="mt-4 font-display text-xl leading-snug font-bold sm:text-2xl [&_p]:m-0" set:html={p.antivirus.paras[0]} />
              </div>
            )}
            <ul class="mt-5 space-y-3" role="list">
              {p.antivirus.paras.slice(1).map((html, i) => {
                const Icon = avIcons[i % avIcons.length];
                return (
                  <li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-lift">
                    <span class:list={['grid size-11 shrink-0 place-items-center rounded-xl', tone(i + 1)]}>
                      <Icon size={20} aria-hidden="true" />
                    </span>
                    <div class:list={['text-[16px] leading-relaxed text-slate-700 [&_p]:m-0', linkStyle]} set:html={html} />
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<!-- 4. Daily Security Practices: timeline -->
{
  p.daily && (
    <section class="section bg-white">
      <div class="container-site grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)] lg:gap-14">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <h2 id={p.daily.id} class={titleCls}>
            {p.daily.title}
          </h2>
          <!-- a week of gold ticks: "daily" without words -->
          <div class="mt-8 max-w-sm rounded-3xl bg-ink p-5 shadow-lift" aria-hidden="true">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-cta" />
              <span class="size-2.5 rounded-full bg-accent" />
              <span class="size-2.5 rounded-full bg-white/30" />
            </div>
            <div class="mt-4 grid grid-cols-7 gap-2">
              {Array.from({ length: 7 }, (_, i) => (
                <span class:list={['day grid aspect-square place-items-center rounded-lg', i === 6 ? 'bg-accent text-ink' : 'bg-white/10 text-accent']} style={`--d:${i * 0.18}s`}>
                  <Check size={16} stroke-width={3} />
                </span>
              ))}
            </div>
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/10">
              <span class="block h-full w-full rounded-full bg-accent" />
            </div>
          </div>
        </div>
        <ol class="relative space-y-5 before:absolute before:top-4 before:bottom-4 before:left-[23px] before:w-0.5 before:bg-[repeating-linear-gradient(to_bottom,var(--brand-accent)_0_6px,transparent_6px_12px)] before:content-['']" role="list">
          {p.daily.paras.map((html, i) => {
            const Icon = dailyIcons[i % dailyIcons.length];
            return (
              <li class="relative flex gap-5">
                <span class:list={['relative z-10 grid size-12 shrink-0 place-items-center rounded-2xl shadow-lift ring-4 ring-white', tone(i)]}>
                  <Icon size={21} aria-hidden="true" />
                </span>
                <div class="flex-1 rounded-2xl bg-primary-tint p-5 ring-1 ring-primary/10 transition hover:-translate-y-0.5 hover:shadow-lift sm:p-6">
                  <span class="font-display text-xs font-extrabold tracking-[0.14em] text-primary/60 tabular-nums">{pad(i + 1)}</span>
                  <div class:list={['mt-1 text-[16.5px] leading-relaxed text-slate-700 [&_p]:m-0', linkStyle]} set:html={html} />
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )
}

<!-- 5. Recognizing Infection Symptoms -->
{
  p.symptoms && (
    <section class="section bg-primary-tint">
      <div class="container-site grid grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="lg:sticky lg:top-28">
          <h2 id={p.symptoms.id} class={titleCls}>
            {p.symptoms.title}
          </h2>
          <div class="relative isolate mt-8 overflow-hidden rounded-3xl bg-primary p-5 shadow-panel sm:p-7">
            <div class={gridBg} aria-hidden="true" />
            <InfectedScreen />
          </div>
        </div>
        <div class="space-y-4">
          {p.symptoms.paras.slice(0, -1).map((html, i) => {
            const Icon = symptomIcons[i % symptomIcons.length];
            return (
              <div class="relative flex gap-4 overflow-hidden rounded-2xl bg-white p-5 ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-lift sm:p-6">
                <span class="absolute inset-y-0 left-0 w-1.5 bg-cta" aria-hidden="true" />
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-cta/[0.1] text-cta">
                  <Icon size={21} aria-hidden="true" />
                </span>
                <div class:list={['text-[16.5px] leading-relaxed text-slate-700 [&_p]:m-0', linkStyle]} set:html={html} />
              </div>
            );
          })}
          {p.symptoms.paras.length > 0 && (
            <a
              href={p.removal ? `#${p.removal.id}` : '#'}
              class="group flex items-center gap-4 rounded-2xl bg-ink p-5 text-white transition hover:-translate-y-0.5 hover:shadow-lift sm:p-6"
            >
              <div class="flex-1 text-[16.5px] leading-relaxed text-white/90 [&_p]:m-0" set:html={p.symptoms.paras[p.symptoms.paras.length - 1]} />
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent text-ink transition group-hover:translate-y-1">
                <ArrowDown size={20} aria-hidden="true" />
              </span>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<!-- 6. Dark blueprint: the removal console -->
{
  p.removal && (
    <section class="section relative isolate overflow-hidden bg-ink text-white" id={p.removal.id}>
      <div class={gridBg} aria-hidden="true" />
      <div class="pointer-events-none absolute -top-40 -right-40 -z-10 size-[36rem] rounded-full bg-primary/40 blur-3xl" aria-hidden="true" />
      <div class="container-site">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end lg:gap-14">
          <h2 class="font-display text-3xl font-extrabold text-white sm:text-4xl">{p.removal.title}</h2>
          <div class="text-lg leading-relaxed text-white/75 [&_p]:m-0" set:html={removalLead} />
        </div>

        {removalSteps.length > 0 && (
          <div class="rc mt-12 overflow-hidden rounded-3xl bg-primary-deep shadow-panel ring-1 ring-white/10" data-console>
            <!-- title bar + progress segments -->
            <div class="flex items-center gap-4 border-b border-white/10 px-5 py-4">
              <div class="flex gap-2" aria-hidden="true">
                <span class="size-3 rounded-full bg-cta" />
                <span class="size-3 rounded-full bg-accent" />
                <span class="size-3 rounded-full bg-white/30" />
              </div>
              <div class="flex flex-1 gap-1.5" aria-hidden="true">
                {removalSteps.map((_, i) => (
                  <span class="rc-seg h-1.5 flex-1 rounded-full bg-white/15" data-seg={i} />
                ))}
              </div>
              <span class="font-display text-xs font-extrabold tracking-[0.14em] text-accent tabular-nums" data-count aria-hidden="true">
                {pad(1)}/{pad(removalSteps.length)}
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-[240px_minmax(0,1fr)]">
              <!-- steps rail (shown when JS runs) -->
              <div class="rc-rail hidden border-white/10 p-3 md:border-r" role="tablist" aria-label={p.removal.title}>
                {removalSteps.map((_, i) => {
                  const Icon = stepIcons[i % stepIcons.length];
                  return (
                    <button
                      type="button"
                      role="tab"
                      id={`rc-tab-${i}`}
                      aria-controls={`rc-panel-${i}`}
                      aria-selected={i === 0 ? 'true' : 'false'}
                      data-step-btn={i}
                      class="group flex w-full items-center gap-3 rounded-2xl p-3 text-left transition hover:bg-white/5 aria-selected:bg-white/10"
                    >
                      <span class="rc-chip grid size-10 shrink-0 place-items-center rounded-xl bg-white/10 text-white transition group-aria-selected:bg-accent group-aria-selected:text-ink">
                        <Icon size={19} aria-hidden="true" />
                      </span>
                      <span class="flex-1">
                        <span class="block font-display text-[11px] font-extrabold tracking-[0.14em] text-white/50 tabular-nums">{pad(i + 1)}</span>
                        <span class="block font-display text-base font-extrabold">{stepLabels[i]}</span>
                      </span>
                      <span class="rc-done grid size-6 place-items-center rounded-full bg-accent text-ink opacity-0 transition" aria-hidden="true">
                        <Check size={13} stroke-width={3.5} />
                      </span>
                    </button>
                  );
                })}
              </div>

              <!-- panels: all in the HTML -->
              <div class="relative min-h-[18rem]">
                {removalSteps.map((html, i) => {
                  const Icon = stepIcons[i % stepIcons.length];
                  return (
                    <div id={`rc-panel-${i}`} role="tabpanel" aria-labelledby={`rc-tab-${i}`} data-step-panel={i} class="rc-panel relative isolate overflow-hidden p-6 sm:p-9">
                      <Icon size={220} stroke-width={1} class="pointer-events-none absolute -right-10 -bottom-12 -z-10 text-white/[0.05]" aria-hidden="true" />
                      <div class="flex items-center gap-4">
                        <span class:list={['grid size-14 place-items-center rounded-2xl', ['bg-accent text-ink', 'bg-cta text-white', 'bg-primary text-white ring-1 ring-white/20', 'bg-accent text-ink'][i % 4]]}>
                          <Icon size={26} aria-hidden="true" />
                        </span>
                        <p class="font-display text-2xl font-extrabold">
                          <span class="mr-2 text-accent tabular-nums">{pad(i + 1)}</span>
                          {stepLabels[i]}
                        </p>
                      </div>
                      <div class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 [&_p]:m-0" set:html={html} />
                      <!-- scan-log lines (decoration) -->
                      <div class="mt-8 max-w-md space-y-2" aria-hidden="true">
                        {[78, 56, 92].map((w, k) => (
                          <div class="flex items-center gap-3">
                            <span class:list={['size-2 rounded-full', k === 2 ? 'bg-accent' : 'bg-white/30']} />
                            <span class="rc-log h-1.5 rounded-full bg-white/15" style={`width:${w}%;--k:${k}`} />
                          </div>
                        ))}
                      </div>
                      <div class="rc-nav mt-8 hidden items-center gap-3">
                        {i > 0 && (
                          <button type="button" data-go={i - 1} class="btn-outline-light min-h-11 px-4 text-sm">
                            <ChevronLeft size={16} aria-hidden="true" /> Back
                          </button>
                        )}
                        {i < removalSteps.length - 1 ? (
                          <button type="button" data-go={i + 1} class="btn min-h-11 bg-accent px-5 text-sm text-ink hover:brightness-95">
                            Next step <ArrowRight size={16} aria-hidden="true" />
                          </button>
                        ) : (
