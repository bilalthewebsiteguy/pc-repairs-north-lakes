---
/**
 * Original line-and-colour laptop illustrations for the brand tiles.
 * No logos or product photos: each brand gets a different *kind* of laptop
 * (gaming, dual-screen, ultrabook, business, convertible, classic) so the
 * tiles look distinct while staying in the North Lakes palette.
 */
interface Props {
  kind: 'gaming' | 'dual' | 'ultra' | 'business' | 'convertible' | 'classic';
}
const { kind } = Astro.props;
const ink = 'var(--brand-ink)';
const blue = 'var(--brand-primary)';
const gold = 'var(--brand-accent)';
const orange = 'var(--brand-cta)';
const id = `g-${kind}`;
---

<svg viewBox="0 0 240 150" class="h-auto w-full" aria-hidden="true" fill="none" stroke-linejoin="round" stroke-linecap="round">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={blue}></stop>
      <stop offset="1" stop-color="color-mix(in oklab, var(--brand-primary), black 45%)"></stop>
    </linearGradient>
  </defs>

  {kind === 'gaming' && (
    <g>
      <!-- angular gaming laptop with lit keyboard and vents -->
      <path d="M58 22 H182 L188 100 H52 Z" fill={ink} />
      <path d="M64 28 H176 L181 94 H59 Z" fill={`url(#${id})`} />
      <path d="M70 80 L95 52 L112 66 L138 38 L170 74" stroke={gold} stroke-width="3" />
      <path d="M40 104 H200 L214 124 H26 Z" fill={ink} />
      {[0, 1, 2].map((r) => (
        <path d={`M${52 - r * 4} ${108 + r * 5} H${188 + r * 4}`} stroke={r === 1 ? orange : gold} stroke-width="2.5" stroke-dasharray="7 3" />
      ))}
      <path d="M26 124 H214 L210 130 H30 Z" fill="color-mix(in oklab, var(--brand-ink), white 25%)" />
      <path d="M34 128 h10 M50 128 h10 M180 128 h10 M196 128 h10" stroke={orange} stroke-width="2" />
    </g>
  )}

  {kind === 'dual' && (
    <g>
      <!-- dual-screen laptop: second display above the keyboard -->
      <rect x="56" y="16" width="128" height="78" rx="4" fill={ink} />
      <rect x="61" y="21" width="118" height="68" rx="2" fill={`url(#${id})`} />
      <rect x="72" y="32" width="44" height="28" rx="3" fill={gold} opacity="0.9" />
      <rect x="122" y="32" width="46" height="8" rx="2" fill="white" opacity="0.6" />
      <rect x="122" y="44" width="34" height="8" rx="2" fill="white" opacity="0.35" />
      <path d="M44 98 H196 L210 132 H30 Z" fill="#cbd5e1" />
      <path d="M50 101 H190 L194 112 H46 Z" fill={`url(#${id})`} />
      <path d="M60 106 h40 M108 106 h26" stroke={gold} stroke-width="3" />
      <path d="M46 116 H194 L200 128 H40 Z" fill="#e2e8f0" />
      <path d="M52 120 H188 M50 124 H190" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 3" />
    </g>
  )}

  {kind === 'ultra' && (
    <g>
      <!-- thin ultrabook, edge-to-edge screen, silver wedge base -->
      <rect x="54" y="14" width="132" height="92" rx="5" fill="#cbd5e1" />
      <rect x="57" y="17" width="126" height="86" rx="3" fill={`url(#${id})`} />
      <circle cx="150" cy="44" r="18" fill={gold} opacity="0.85" />
      <path d="M57 86 Q100 62 140 78 T183 70 V103 H57 Z" fill="white" opacity="0.18" />
      <path d="M30 110 H210 L216 118 H24 Z" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
      <path d="M104 110 h32" stroke="#94a3b8" stroke-width="2" />
      <path d="M24 118 H216" stroke="#94a3b8" stroke-width="1.5" />
    </g>
  )}

  {kind === 'business' && (
    <g>
      <!-- dark business laptop with pointing stick and trackpad buttons -->
      <rect x="56" y="16" width="128" height="80" rx="3" fill={ink} />
      <rect x="62" y="22" width="116" height="68" rx="1" fill="#f1f5f9" />
      <rect x="70" y="30" width="56" height="6" rx="2" fill={blue} />
      <rect x="70" y="42" width="98" height="4" rx="2" fill="#cbd5e1" />
      <rect x="70" y="50" width="88" height="4" rx="2" fill="#cbd5e1" />
      <rect x="70" y="62" width="40" height="20" rx="2" fill={gold} opacity="0.85" />
      <rect x="116" y="62" width="52" height="20" rx="2" fill={blue} opacity="0.35" />
      <path d="M40 100 H200 L212 134 H28 Z" fill="color-mix(in oklab, var(--brand-ink), white 12%)" />
      {[0, 1, 2, 3].map((r) => (
        <path d={`M${50 - r * 2} ${106 + r * 5} H${190 + r * 2}`} stroke="color-mix(in oklab, var(--brand-ink), white 40%)" stroke-width="3" stroke-dasharray="8 2.5" />
      ))}
      <circle cx="120" cy="116" r="3" fill={orange} />
      <path d="M100 128 h40" stroke={orange} stroke-width="2.5" />
    </g>
  )}

  {kind === 'convertible' && (
    <g>
      <!-- 2-in-1 folded into "tent" mode, screen facing out -->
      <path d="M120 18 L60 128 H74 L120 40 Z" fill="#cbd5e1" />
      <path d="M120 18 L188 128 H50 Z" fill={ink} />
      <path d="M121 30 L176 122 H64 Z" fill={`url(#${id})`} />
      <path d="M92 104 L112 76 L126 92 L142 70 L162 104" stroke={gold} stroke-width="3" />
      <circle cx="128" cy="58" r="7" fill={orange} />
      <path d="M40 128 H200" stroke="#94a3b8" stroke-width="2" />
    </g>
  )}

  {kind === 'classic' && (
    <g>
      <!-- classic laptop with a cylinder hinge -->
      <rect x="54" y="14" width="132" height="84" rx="4" fill="color-mix(in oklab, var(--brand-ink), white 8%)" />
      <rect x="61" y="21" width="118" height="70" rx="2" fill={`url(#${id})`} />
      <path d="M61 70 C90 50 110 82 140 60 S170 54 179 58 V91 H61 Z" fill={gold} opacity="0.85" />
      <rect x="66" y="98" width="108" height="9" rx="4.5" fill="#94a3b8" />
      <rect x="66" y="98" width="20" height="9" rx="4.5" fill={orange} />
      <path d="M36 107 H204 L214 130 H26 Z" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
      <path d="M46 113 H194 M44 118 H196" stroke="#94a3b8" stroke-width="2" stroke-dasharray="7 3" />
      <rect x="104" y="122" width="32" height="5" rx="2" fill="#cbd5e1" />
    </g>
  )}
</svg>
