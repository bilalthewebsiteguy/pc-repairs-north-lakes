<CtaBand />

<style>
  .day {
    animation: day-pop 4.2s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes day-pop {
    0%,
    100% {
      transform: none;
    }
    8% {
      transform: translateY(-3px);
    }
    16% {
      transform: none;
    }
  }
  .rc-log {
    transform-origin: left center;
    animation: rc-log 2.4s ease-out both;
    animation-delay: calc(var(--k) * 0.25s);
  }
  @keyframes rc-log {
    from {
      transform: scaleX(0);
    }
  }
  /* JS on: show rail + nav, one panel at a time */
  :global(.js) .rc-rail {
    display: block;
  }
  :global(.js) .rc-nav {
    display: flex;
  }
  :global(.js) .rc-panel:not(.is-active) {
    display: none;
  }
  .rc-panel.is-active {
    animation: rc-in 0.35s ease-out;
  }
  @keyframes rc-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .rc-seg.is-on {
    background: var(--brand-accent);
  }
  [data-step-btn].is-done .rc-done {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .day,
    .rc-log,
    .rc-panel.is-active {
      animation: none;
    }
  }
</style>

<script>
  // Removal console: one step at a time
  for (const root of document.querySelectorAll<HTMLElement>('[data-console]')) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-step-btn]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-step-panel]')];
    const segs = [...root.querySelectorAll<HTMLElement>('[data-seg]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const pad = (n: number) => String(n).padStart(2, '0');
    const show = (i: number, focus = false) => {
      btns.forEach((b, k) => {
        b.setAttribute('aria-selected', String(k === i));
        b.tabIndex = k === i ? 0 : -1;
        b.classList.toggle('is-done', k < i);
      });
      panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
      segs.forEach((s, k) => s.classList.toggle('is-on', k <= i));
      if (count) count.textContent = `${pad(i + 1)}/${pad(panels.length)}`;
      if (focus) btns[i]?.focus();
    };
    btns.forEach((b, i) => {
      b.addEventListener('click', () => show(i));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') (e.preventDefault(), show(Math.min(i + 1, btns.length - 1), true));
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') (e.preventDefault(), show(Math.max(i - 1, 0), true));
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go), true)));
    show(0);
  }

  // FAQ search: filter the numbered questions live
  for (const root of document.querySelectorAll<HTMLElement>('[data-faq-more]')) {
    const input = root.querySelector<HTMLInputElement>('[data-faq-search]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-faq-item]')];
    const empty = root.querySelector<HTMLElement>('[data-faq-empty]');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const it of items) {
        const hit = !q || (it.dataset.text ?? '').includes(q);
        it.hidden = !hit;
        if (hit) shown++;
      }
      empty?.classList.toggle('hidden', shown > 0);
    });
  }
</script>
