---
/**
 * Searchable directory of the page's "most popular services" list (41 WordPress items).
 * Every card keeps its WordPress link and description. Typing in the box filters the cards;
 * without JavaScript all cards simply show.
 */
import Search from '@lucide/astro/icons/search';
import { serviceIcon as iconFor, serviceSearchWords as extraWords } from '../lib/service-icons';

interface Props {
  lead: string;
  services: { name: string; href: string; html: string }[];
}
const { lead, services } = Astro.props;

const tones = ['bg-primary text-white', 'bg-accent text-ink', 'bg-cta text-white'];
---

<div data-directory class="is-collapsed">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <p class="max-w-2xl font-display text-2xl leading-snug font-extrabold text-ink sm:text-3xl">{lead}</p>
    <label class="relative block w-full lg:max-w-sm">
      <span class="sr-only">Search our services</span>
      <Search size={18} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-slate-400" aria-hidden="true" />
      <input
        type="search"
        data-filter
        placeholder="Search services, e.g. virus, wifi, screen"
        class="h-13 w-full rounded-xl border-2 border-slate-200 bg-white pr-4 pl-11 text-base text-ink transition outline-none placeholder:text-slate-400 focus:border-primary"
        autocomplete="off"
      />
    </label>
  </div>
  <p class="mt-3 text-sm font-semibold text-slate-500" data-count aria-live="polite">{services.length} services</p>

  <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3" role="list">
    {
      services.map((s, i) => {
        const Icon = iconFor(s.name);
        return (
          <li data-item data-extra={i >= 12 ? '' : undefined} data-text={`${s.name} ${s.html.replace(/<[^>]+>/g, '')} ${extraWords(s.name)}`.toLowerCase()} class="group relative rounded-2xl bg-white p-5 ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-lift hover:ring-primary/40">
            <div class="flex items-start gap-4">
              <span class:list={['grid size-11 shrink-0 place-items-center rounded-xl', tones[i % 3]]}>
                <Icon size={20} aria-hidden="true" />
              </span>
              <div class="min-w-0">
                <a href={s.href} class="font-display text-[17px] leading-snug font-extrabold text-ink hover:text-primary">
                  {s.name}
                </a>
                <p class="mt-1.5 text-[14.5px] leading-relaxed text-slate-600 [&_a]:text-slate-600 [&_a]:no-underline" set:html={s.html} />
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
  {
    services.length > 12 && (
      <div class="mt-8 text-center" data-more-wrap>
        <button type="button" data-more class="btn-outline">
          Show all {services.length} services
        </button>
      </div>
    )
  }
  <p data-empty hidden class="mt-6 rounded-xl bg-primary-tint p-5 text-slate-600">
    No service matches that search. Call us and describe the problem.
  </p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-directory]')) {
    const input = root.querySelector<HTMLInputElement>('[data-filter]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const total = items.length;
    const more = root.querySelector<HTMLButtonElement>('[data-more]');
    more?.addEventListener('click', () => {
      root.classList.remove('is-collapsed');
      more.parentElement!.hidden = true;
    });
    input.addEventListener('input', () => {
      if (input.value.trim()) {
        root.classList.remove('is-collapsed');
        if (more) more.parentElement!.hidden = true;
      }
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const it of items) {
        const hit = !q || q.split(/\s+/).every((w) => it.dataset.text!.includes(w));
        it.hidden = !hit;
        if (hit) shown++;
      }
      count.textContent = q ? `${shown} of ${total} services` : `${total} services`;
      empty.hidden = shown > 0;
    });
  }
</script>

<style>
  [data-directory].is-collapsed [data-extra] {
    display: none;
  }
</style>
