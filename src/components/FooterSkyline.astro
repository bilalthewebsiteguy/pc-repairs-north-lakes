      <rect x="460" y="208" width="28" height="32" />
      <path d="M474 208 V240" />
      <path d="M474 156 V176 M464 166 H484" />
      <path d="M410 240 V270 M440 240 V270 M474 240 V270 M508 240 V270 M538 240 V270" />
      <path d="M474 240 L496 270 M478 248 H492 M484 256 H496" />
      <path d="M410 255 L440 240 M440 255 L410 240" stroke-dasharray="3 4" />
