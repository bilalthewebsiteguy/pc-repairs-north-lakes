---
// Sticky side card next to page text: call + quote + main services.
import Check from '@lucide/astro/icons/check';
import Phone from '@lucide/astro/icons/phone';
import { site, type NavItem } from '../config/site';

interface Props {
  heading: string;
}
const { heading } = Astro.props;
const services = (site.nav as readonly NavItem[]).find((n) => n.children)?.children ?? [];
---

<aside class="space-y-5 lg:sticky lg:top-28">
  <div class="relative overflow-hidden rounded-2xl bg-primary p-6 text-white shadow-lift">
    <div class="pointer-events-none absolute -top-14 -right-14 size-40 rounded-full bg-white/10" aria-hidden="true"></div>
    <p class="font-display text-xl font-extrabold">{heading}</p>
    <ul class="mt-4 space-y-2.5 text-[15px]">
      {
        ['Same-day service', 'Laptop, PC & Mac repairs', 'Home & business call-outs'].map((p) => (
          <li class="flex items-center gap-2.5">
            <span class="grid size-5 shrink-0 place-items-center rounded-full bg-accent text-ink">
              <Check size={12} stroke-width={3.5} aria-hidden="true" />
            </span>
            {p}
          </li>
        ))
      }
    </ul>
    <div class="mt-6 grid gap-2.5">
      <a href={`tel:${site.phone.tel}`} class="btn-cta"><Phone size={18} aria-hidden="true" /> {site.phone.display}</a>
      <a href={site.quoteUrl} class="btn-outline-light">Get a Quote</a>
    </div>
  </div>
  <nav aria-label="Our services" class="card p-6">
    <p class="font-display font-bold text-primary">Our services</p>
    <ul class="mt-3 divide-y divide-slate-100">
      {services.map((s) => <li><a href={s.href} class="block py-2.5 font-semibold text-slate-700 hover:text-primary">{s.label}</a></li>)}
      <li><a href="/services/" class="block py-2.5 font-semibold text-cta">All services →</a></li>
    </ul>
  </nav>
</aside>
