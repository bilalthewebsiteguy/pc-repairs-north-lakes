<CtaBand />

<style>
  /* Findings header bars fill one after another */
  .kt-bar > span {
    transform-origin: left center;
    animation: kt-fill 4s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes kt-fill {
    0% {
      transform: scaleX(0);
    }
    30%,
    85% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }
  .day {
    animation: day-pop 4.2s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes day-pop {
    0%,
    100% {
      transform: none;
    }
    8% {
      transform: translateY(-3px);
    }
    16% {
      transform: none;
    }
  }

  /* antivirus gauges + removal line: draw in when scrolled into view (JS adds .is-in) */
  .av-gauge-fill {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.2s cubic-bezier(0.3, 0, 0.2, 1);
  }
  :global(.js) .av-gauge:not(.is-in) .av-gauge-fill {
    stroke-dashoffset: 100;
  }
  .pipe-fill {
    transform-origin: left center;
    transition: transform 1.6s cubic-bezier(0.3, 0, 0.2, 1);
  }
  :global(.js) [data-pipe]:not(.is-in) .pipe-fill {
    transform: scaleX(0);
  }

  /* symptom checker */
  .sc-needle {
    transform-origin: 110px 112px;
    transform: rotate(var(--a));
    transition: transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .sc-card:has([aria-pressed='true']) {
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 2px var(--brand-accent);
  }
  .sc-call.is-hot {
    animation: sc-pulse 1.6s ease-in-out infinite;
  }
  @keyframes sc-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--brand-cta), transparent 40%);
    }
    50% {
      box-shadow: 0 0 0 10px color-mix(in oklab, var(--brand-cta), transparent 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .day,
    .kt-bar > span,
    .sc-call.is-hot {
      animation: none;
    }
    .av-gauge-fill,
    .pipe-fill,
    .sc-needle {
      transition: none;
    }
  }
</style>

<script>
  // Draw the gauges / pipeline line once they scroll into view
  const targets = document.querySelectorAll<Element>('.av-gauge, [data-pipe]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    targets.forEach((t) => io.observe(t));
  } else {
    targets.forEach((t) => t.classList.add('is-in'));
  }

  // Symptom checker: tick what you see, the needle moves (-90deg = none, +90deg = all)
  for (const root of document.querySelectorAll<HTMLElement>('[data-checker]')) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-sc-btn]')];
    const needle = root.querySelector<SVGGElement>('[data-sc-needle]');
    const count = root.querySelector<HTMLElement>('[data-sc-count]');
    const call = root.querySelector<HTMLElement>('[data-sc-call]');
    const update = () => {
      const n = btns.filter((b) => b.getAttribute('aria-pressed') === 'true').length;
      const a = btns.length ? -90 + (180 * n) / btns.length : -90;
      needle?.style.setProperty('--a', `${a}deg`);
      if (count) count.textContent = String(n);
      call?.classList.toggle('is-hot', n > 0);
    };
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
        update();
      }),
    );
    update();
  }
</script>
