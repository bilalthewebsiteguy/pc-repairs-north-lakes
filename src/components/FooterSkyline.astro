    <!-- shopping centre: long low building with a curved canopy -->
    <g>
      <path d="M790 270 V186 H1050 V270" />
      <path d="M790 186 C860 150 980 150 1050 186" />
      <path d="M800 200 H1040" />
      <path d="M830 200 V270 M870 200 V270 M970 200 V270 M1010 200 V270" stroke-dasharray="3 6" />
      <path d="M890 270 V224 H950 V270" />
      <path d="M920 224 V270" />
      <path d="M884 224 C900 210 940 210 956 224" />
      <rect x="880" y="160" width="80" height="18" rx="2" />
