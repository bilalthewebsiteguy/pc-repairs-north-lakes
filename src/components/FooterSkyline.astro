    <!-- North Lakes lake: water, sailboat, fountain -->
    <g>
      <path d="M580 270 C610 262 640 262 670 270 C700 262 730 262 760 270" />
      <path d="M598 258 h22 M650 256 h30 M708 258 h24" stroke-dasharray="6 5" />
      <path d="M612 246 H660 L652 256 H620 Z" />
      <path d="M636 246 V178 L664 240 H636" />
      <path d="M636 186 L614 240 H636" />
      <path d="M712 256 V214" />
      <path d="M712 214 C700 196 690 196 684 210 M712 214 C724 196 734 196 740 210 M712 214 C708 192 712 182 718 180" />
