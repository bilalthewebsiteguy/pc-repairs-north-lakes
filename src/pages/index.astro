---
// src/pages/index.astro - Homepage (North Lakes design).
// SEO comes from src/content/pages/index.md (unchanged WordPress values).
// Section text is read from the same file by src/lib/home.ts, so the words match WordPress.
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import Cpu from '@lucide/astro/icons/cpu';
import Download from '@lucide/astro/icons/download';
import FileText from '@lucide/astro/icons/file-text';
import Gauge from '@lucide/astro/icons/gauge';
import HardDrive from '@lucide/astro/icons/hard-drive';
import Laptop from '@lucide/astro/icons/laptop';
import Mail from '@lucide/astro/icons/mail';
import MemoryStick from '@lucide/astro/icons/memory-stick';
import MonitorCheck from '@lucide/astro/icons/monitor-check';
import Plus from '@lucide/astro/icons/plus';
import Printer from '@lucide/astro/icons/printer';
import Quote from '@lucide/astro/icons/quote';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Star from '@lucide/astro/icons/star';
import Bug from '@lucide/astro/icons/bug';
import Wifi from '@lucide/astro/icons/wifi';
import Wrench from '@lucide/astro/icons/wrench';
import { getCollection, render } from 'astro:content';
import CtaBand from '../components/CtaBand.astro';
import HomeHero from '../components/HomeHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { pageHeading } from '../lib/heading';
import { homeSections } from '../lib/home';
import { faqQuestions } from '../config/faq';

const [home] = await getCollection('pages', (p) => p.data.path === '/');
if (!home) throw new Error('No page with path "/" found in src/content/pages (should be index.md)');
const { remarkPluginFrontmatter } = await render(home);
const heading = pageHeading(home.data, remarkPluginFrontmatter);
const s = await homeSections(home.body ?? '');

// Icons for the service cards (replace the old 2016 clipart images)
const iconFor: Record<string, typeof Wrench> = {
  'computer repair': Wrench,
  'computer speed up': Gauge,
  'computer upgrade': MemoryStick,
  'virus removal': Bug,
  'internet security': ShieldCheck,
  'file recovery': HardDrive,
  'setup new device': Printer,
  'new computer': MonitorCheck,
  'software installation': Download,
  'hardware installation': Cpu,
  'setup email': Mail,
  'setup network': Wifi,
};

const latestPosts = (await getCollection('posts'))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);
const fmt = (d?: Date) => d?.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

// Reviews + laptop/Mac callout + directory listings - text copied word for word from the
// WordPress "Testimonials" section (its WOMO review widget was a script that didn't export).
const womoUrl = 'https://www.womo.com.au/certificate/1179805-Fix-It-Computer-Repairs-Calamvale';
// Links taken from the WordPress FAQ text.
const wordOfMouthUrl = 'https://www.wordofmouth.com.au/reviews/zoo-computer-repairs';
const channel9Url = 'https://www.youtube.com/watch?v=8tFBIJGjvgk';
const hardwareProblems = [
  'Laptop Screen Smashed or a nothing on screen?',
  'Apple Mac Book or iMac not turning on?',
  'Keyboard Not working / keys Missing?',
  'Laptop is not powering on?',
];
const directories = [
  {
    href: 'https://www.www.truelocal.com.au/business/fix-it-home-computer-repairs-brisbane/calamvale',
    image: '/images/truelocal.webp',
    alt: 'Truelocal-Business-300x97',
  },
  {
    href: 'https://www.yellowpages.com.au/qld/calamvale/computer-repairs-brisbane-15171563-listing.html?referredBy=www.yellowpages.com.au&context=businessTypeSearch',
    image: '/images/yellowpages.webp',
    alt: 'yellowpages-300x106',
  },
];

// The WordPress About photo (Robert.png), saved locally in public/images.
const aboutPhoto = s.about.image?.endsWith('/Robert.png') ? '/images/robert.png' : s.about.image;

// Laptop brand logos from the WordPress site, saved locally in public/images/brands.
const brandLogo = (src: string) => {
  const file = src.split('/').pop()?.toLowerCase() ?? '';
  const key = ['acer', 'asus', 'dell', 'lenovo', 'hp', 'sony'].find((k) => file.startsWith(k));
  return key ? `/images/brands/${key}.png` : src;
};



const sectionTitle = 'text-3xl font-extrabold sm:text-4xl';

// Colour treatment for each service tile. Tiles 1, 7 and 11 are wide solid blocks
// (this fills a 3-column grid exactly: 2+1 / 1+1+1 / 1+2 / 1+1+1 / 2+1).
const wideTones = [
  { tile: 'bg-primary', chip: 'bg-accent text-ink' },
  { tile: 'bg-ink', chip: 'bg-cta text-white' },
  { tile: 'bg-primary-deep', chip: 'bg-accent text-ink' },
];
const lightTones = [
  { tile: 'bg-primary-tint ring-1 ring-primary/10', chip: 'bg-primary text-white', ghost: 'text-primary/[0.06]' },
  { tile: 'bg-accent-soft/60 ring-1 ring-accent/30', chip: 'bg-accent text-ink', ghost: 'text-accent/15' },
  { tile: 'bg-cta/[0.07] ring-1 ring-cta/15', chip: 'bg-cta text-white', ghost: 'text-cta/[0.07]' },
];
const WIDE = [0, 6, 10];
function tileTone(i: number) {
  const w = WIDE.indexOf(i);
  if (w >= 0) {
    return {
      ...wideTones[w],
      wide: true,
      ghost: 'text-white/[0.08] md:size-[230px]',
      title: 'text-white',
      text: 'text-white/85 [&_a]:text-accent [&_a]:underline',
    };
  }
  const n = i - WIDE.filter((x) => x < i).length;
  return { ...lightTones[n % 3], wide: false, title: '', text: 'text-slate-700' };
}

---

<BaseLayout seo={home.data}>
  <HomeHero title={heading} />

  <!-- OUR SERVICES: colour-blocked mosaic. Three wide solid tiles break up the grid;
       the rest cycle through blue, gold and orange tints. White section background. -->
  <section class="section" aria-labelledby="services-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <h2 id="services-title" class="text-3xl font-extrabold sm:text-4xl lg:text-5xl">{s.services.title}</h2>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
          <p class="text-lg text-slate-600 xl:whitespace-nowrap">Not sure which one you need? Describe the problem and we'll tell you.</p>
          <a href={site.quoteUrl} class="btn-cta shrink-0 self-start sm:self-auto"><FileText size={18} aria-hidden="true" /> Get a Quote</a>
        </div>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-flow-dense md:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        {
          s.services.items.map((item, i) => {
            const Icon = iconFor[item.title.toLowerCase()] ?? Wrench;
            const t = tileTone(i);
            return (
              <li class:list={['relative isolate overflow-hidden rounded-2xl p-7 sm:p-8', t.tile, t.wide && 'md:col-span-2']}>
                <Icon
                  size={150}
                  stroke-width={1.25}
                  aria-hidden="true"
                  class:list={['pointer-events-none absolute -right-8 -bottom-8 -z-10', t.ghost]}
                />
                <span class:list={['grid size-14 place-items-center rounded-xl', t.chip]}>
                  <Icon size={26} aria-hidden="true" />
                </span>
                <h3 class:list={['mt-5 text-2xl', t.title]}>{item.title}</h3>
                <div class:list={['mt-3 leading-relaxed', t.wide && 'max-w-2xl', t.text]} set:html={item.html} />
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Laptop Repairs North Lakes -->
  <section class="section bg-primary-tint" aria-labelledby="laptop-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
      <div>
        <h2 id="laptop-title" class={sectionTitle}>{s.laptop.title}</h2>
        <div class="mt-4 text-lg text-slate-600" set:html={s.laptop.introHtml} />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/laptop-repair/" class="btn-primary">Laptop repairs <ArrowRight size={18} aria-hidden="true" /></a>
          <a href={site.quoteUrl} class="btn-outline">Get a Quote</a>
        </div>
      </div>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
        {
          s.laptop.brands.map((b) => {
            const name = b.alt.replace(/\s*laptop repair\s*$/i, '');
            return (
              <li>
                <a
                  href={b.href}
                  class="group flex h-full flex-col rounded-2xl bg-white ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lift hover:ring-primary/40 focus-visible:ring-2 focus-visible:ring-primary"
                >
                  <span class="grid h-28 place-items-center px-6">
                    <img src={brandLogo(b.image)} alt={b.alt} loading="lazy" class="max-h-12 w-auto max-w-[78%] object-contain" />
                  </span>
                  <span class="flex items-center justify-between border-t border-slate-100 px-5 py-3 text-sm font-semibold text-slate-600 group-hover:text-primary">
                    {name} repairs
                    <ArrowRight size={16} class="transition-transform group-hover:translate-x-1" aria-hidden="true" />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- About: the WordPress photo is only 150px, so it is shown at about its real size
       inside a profile card (with Robert's own quote) instead of stretched into a big frame. -->
  <section class="section overflow-x-clip" aria-labelledby="about-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-16">
      <div>
        <h2 id="about-title" class={sectionTitle}>{s.about.title}</h2>
        <div class="mt-5 space-y-4 text-lg leading-relaxed text-slate-600" set:html={s.about.html} />
        <a href={`tel:${site.phone.tel}`} class="btn-cta mt-8">Call {site.phone.display}</a>
      </div>
      <figure class="relative isolate overflow-hidden rounded-3xl bg-primary p-8 text-white sm:p-10">
        <Quote size={150} stroke-width={1.25} class="pointer-events-none absolute -top-6 -right-6 -z-10 text-white/[0.07]" aria-hidden="true" />
        <div class="flex items-center gap-5">
          {aboutPhoto && (
            <img
              src={aboutPhoto}
              alt={s.about.caption ?? ''}
              width="150"
              height="158"
              loading="lazy"
              class="size-28 shrink-0 rounded-full object-cover ring-4 ring-accent"
            />
          )}
          <figcaption class="leading-snug">
            <span class="block font-display text-xl font-bold">Robert</span>
            {s.about.caption && <span class="mt-1 inline-block rounded-md bg-accent px-2.5 py-1 font-display text-sm font-bold text-ink">{s.about.caption}</span>}
          </figcaption>
        </div>
        {s.about.quote && <blockquote class="mt-7 border-t border-white/15 pt-6 text-lg leading-relaxed text-white/90 italic">“{s.about.quote}”</blockquote>}
      </figure>
    </div>
  </section>

  <!-- Testimonials + laptop/Mac hardware callout -->
  <section class="section bg-primary-tint" aria-labelledby="testimonials-title">
    <div class="container-site">
      <h2 id="testimonials-title" class={sectionTitle}>{s.testimonialsTitle}</h2>
      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <!-- Reviews card: the WordPress WOMO widget was a script that didn't export, so this shows
             the business's own review claims (About + FAQ text) and links to the real review pages. -->
        <div class="card flex min-w-0 flex-col p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex gap-1 text-accent" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <Star size={22} fill="currentColor" />)}
            </div>
            <span class="font-display text-sm font-bold text-slate-500">5-star rated on Word of Mouth</span>
          </div>
          <p class="mt-5 font-display text-2xl leading-snug font-extrabold text-ink">
            More 5 star repairs than any other computer repair business in Australia.
          </p>
          <p class="mt-3 text-slate-600">
            Featured on Channel 9 News, which you can <a href={channel9Url} class="font-semibold text-primary underline decoration-accent decoration-2 underline-offset-4">watch here</a>.
          </p>
          <div class="mt-6 mb-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6">
            <a href={wordOfMouthUrl} class="btn-primary self-start">Read our reviews <ArrowRight size={18} aria-hidden="true" /></a>
            <a href={womoUrl} class="inline-flex items-center gap-1.5 font-display text-sm font-bold text-primary hover:underline">
              Fix It Computer Repairs Reviews <ArrowRight size={16} aria-hidden="true" />
            </a>
          </div>
          <div class="mt-auto border-t border-slate-100 pt-6">
            <p class="text-sm font-semibold text-slate-500">Also listed on</p>
            <ul class="mt-3 flex flex-wrap items-center gap-4">
              {
                directories.map((d) => (
                  <li>
                    <a href={d.href} class="block rounded-lg bg-white px-3 py-2 ring-1 ring-slate-200 transition hover:ring-primary/40">
                      <img src={d.image} alt={d.alt} width="300" height="100" loading="lazy" class="h-10 w-auto" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="relative isolate min-w-0 overflow-hidden rounded-xl bg-primary p-6 text-white sm:p-8">
          <Laptop size={180} stroke-width={1} class="pointer-events-none absolute -right-8 -bottom-10 -z-10 text-white/[0.07]" aria-hidden="true" />
          <p class="font-display text-xl font-extrabold tracking-wide text-accent uppercase">
            LAPTOP HARDWARE /<br />MAC HARDWARE PROBLEMS ONLY
          </p>
          <ul class="mt-5 space-y-2.5">
            {
              hardwareProblems.map((p) => (
                <li class="flex gap-3">
                  <Check size={18} stroke-width={3} class="mt-1 shrink-0 text-accent" aria-hidden="true" />
                  {p}
                </li>
              ))
            }
          </ul>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={site.quoteUrl} class="btn-cta">Get Quote</a>
            <p class="text-sm text-white/75">To fill out a form to get a quote directly online.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.6fr)]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 id="faq-title" class={sectionTitle}>{s.faq.title}</h2>
        <a href={site.quoteUrl} class="btn-cta mt-8"><FileText size={18} aria-hidden="true" /> Get a Quote</a>
      </div>
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {
          s.faq.answers.map((html, i) => (
            <details name="faq" class="group" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-display text-lg font-bold text-ink transition-colors hover:text-primary [&::-webkit-details-marker]:hidden">
                <span>{faqQuestions[i] ?? `Question ${i + 1}`}</span>
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary-tint text-primary transition group-open:rotate-45 group-open:bg-primary group-open:text-white">
                  <Plus size={18} aria-hidden="true" />
                </span>
              </summary>
              <div class="pr-12 pb-6 leading-relaxed text-slate-600 [&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_a]:decoration-accent [&_a]:decoration-2 [&_a]:underline-offset-4" set:html={html} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Useful Articles (empty on WordPress - now shows the latest blog posts) -->
  <section class="section bg-primary-tint" aria-labelledby="articles-title">
    <div class="container-site">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 id="articles-title" class={sectionTitle}>{s.articlesTitle}</h2>
        </div>
        <a href="/blog/" class="flex items-center gap-2 font-display font-bold text-primary">
          All articles <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          latestPosts.map((post) => (
            <li>
              <a href={post.data.path} class="card card-hover group flex h-full flex-col p-6">
                {post.data.date && <p class="text-sm font-semibold text-slate-500">{fmt(post.data.date)}</p>}
                <h3 class="mt-2 text-lg leading-snug">{post.data.title}</h3>
                <span class="mt-auto flex items-center gap-1.5 pt-5 font-display text-sm font-bold text-cta">
                  Read article <ArrowRight size={15} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
