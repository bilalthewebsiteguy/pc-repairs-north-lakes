---
// src/pages/[...slug].astro
// Builds EVERY exported page and post at its exact old WordPress URL.
// Picks a template by page type: suburb page, blog post, or service/general page.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SuburbTemplate from '../components/templates/SuburbTemplate.astro';
import ServiceTemplate from '../components/templates/ServiceTemplate.astro';
import LaptopTemplate from '../components/templates/LaptopTemplate.astro';
import NorthLakesTemplate from '../components/templates/NorthLakesTemplate.astro';
import AboutTemplate from '../components/templates/AboutTemplate.astro';
import MacTemplate from '../components/templates/MacTemplate.astro';
import PcServicesTemplate from '../components/templates/PcServicesTemplate.astro';
import ServicesTemplate from '../components/templates/ServicesTemplate.astro';
import AreasTemplate from '../components/templates/AreasTemplate.astro';
import PostTemplate from '../components/templates/PostTemplate.astro';
import { pageHeading } from '../lib/heading';

export async function getStaticPaths() {
  // These paths have their own files in src/pages/, so the catch-all skips them
  const HANDLED_ELSEWHERE = new Set(['/', '/blog/']);

  const pages = (await getCollection('pages')).map((entry) => ({ entry, kind: 'page' as const }));
  const posts = (await getCollection('posts')).map((entry) => ({ entry, kind: 'post' as const }));

  return [...pages, ...posts]
    .filter(({ entry }) => !HANDLED_ELSEWHERE.has(entry.data.path))
    .map(({ entry, kind }) => ({
      // "/computer-repairs-chermside/" -> "computer-repairs-chermside"
      params: { slug: entry.data.path.replace(/^\/|\/$/g, '') },
      props: { entry, kind },
    }));
}

const { entry, kind } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const heading = pageHeading(entry.data, remarkPluginFrontmatter);
const isSuburb = kind === 'page' && entry.data.slug.startsWith('computer-repairs-');
---

<BaseLayout seo={entry.data} type={kind === 'post' ? 'article' : 'website'}>
  {
    kind === 'post' ? (
      <PostTemplate data={entry.data} heading={heading}><Content /></PostTemplate>
    ) : entry.data.path === '/laptop-repair/' ? (
      <LaptopTemplate heading={heading} body={entry.body ?? ''} />
    ) : entry.data.path === '/computer-repairs-north-lakes/' ? (
      <NorthLakesTemplate heading={heading} body={entry.body ?? ''} />
    ) : entry.data.path === '/pc-services-2/' ? (
      <PcServicesTemplate heading={heading} body={entry.body ?? ''} />
    ) : entry.data.path === '/mac-repair-services/' ? (
      <MacTemplate heading={heading} body={entry.body ?? ''} />
    ) : entry.data.path === '/services/' ? (
      <ServicesTemplate heading={heading} body={entry.body ?? ''} />
    ) : entry.data.path === '/areas-we-serve/' ? (
      <AreasTemplate heading={heading} body={entry.body ?? ''} />
    ) : entry.data.path === '/about-us/' ? (
      <AboutTemplate heading={heading} body={entry.body ?? ''} />
    ) : isSuburb ? (
      <SuburbTemplate data={entry.data} heading={heading}><Content /></SuburbTemplate>
    ) : (
      <ServiceTemplate data={entry.data} heading={heading}><Content /></ServiceTemplate>
    )
  }
</BaseLayout>
