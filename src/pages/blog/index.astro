---
// src/pages/blog/index.astro  ->  /blog/
// Lists all blog posts, newest first. SEO comes from src/content/pages/blog.md.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const [blogPage] = await getCollection('pages', (p) => p.data.path === '/blog/');
const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const seo = blogPage?.data ?? { title: 'Blog', path: '/blog/' };
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="mb-8 text-3xl font-bold">Blog</h1>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <li class="rounded-lg border p-5">
            <a href={post.data.path} class="font-semibold hover:underline">{post.data.title}</a>
            {post.data.date && (
              <p class="mt-2 text-sm text-slate-500">
                {post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
