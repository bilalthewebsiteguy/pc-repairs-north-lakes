---
// Laptop Repair page (/laptop-repair/). Same words as WordPress (split by src/lib/laptop.ts),
// laid out as: blue hero, intro, "jump to" tiles, one card per repair with its common signs,
// smaller cards for the extra services, and the areas we serve.
import AppWindow from '@lucide/astro/icons/app-window';
import Bug from '@lucide/astro/icons/bug';
import CircuitBoard from '@lucide/astro/icons/circuit-board';
import FileText from '@lucide/astro/icons/file-text';
import Gauge from '@lucide/astro/icons/gauge';
import HardDrive from '@lucide/astro/icons/hard-drive';
import HeartPulse from '@lucide/astro/icons/heart-pulse';
import Keyboard from '@lucide/astro/icons/keyboard';
import Laptop from '@lucide/astro/icons/laptop';
import MapPin from '@lucide/astro/icons/map-pin';
import Monitor from '@lucide/astro/icons/monitor';
import Phone from '@lucide/astro/icons/phone';
import PlugZap from '@lucide/astro/icons/plug-zap';
import Check from '@lucide/astro/icons/check';
import CtaBand from '../CtaBand.astro';
import IsoPart from '../IsoPart.astro';
import HeroLaptop from '../HeroLaptop.astro';
import LaptopExplorer from '../LaptopExplorer.astro';
import SideCallCard from '../SideCallCard.astro';
import { site } from '../../config/site';
import { laptopSections } from '../../lib/laptop';

interface Props {
  heading: string; // the page's single H1 (same words as the WordPress page)
  body: string; // raw exported markdown of the page
}
const { heading, body } = Astro.props;
const p = await laptopSections(body);

const iconFor: Record<string, typeof Laptop> = {
  screenrepair: Monitor,
  harddrive: HardDrive,
  motherbo: CircuitBoard,
  dcjack: PlugZap,
  keyboard: Keyboard,
  tuneup: Gauge,
  newlaptop: Laptop,
  virus: Bug,
  laptophealth: HeartPulse,
  laptopsoftware: AppWindow,
};
// Brand colour treatments, cycled so neighbouring cards differ
const tones = [
  { chip: 'bg-primary text-white', soft: 'bg-primary-tint', num: 'bg-primary text-white' },
  { chip: 'bg-accent text-ink', soft: 'bg-accent-soft/50', num: 'bg-accent text-ink' },
  { chip: 'bg-cta text-white', soft: 'bg-cta/[0.07]', num: 'bg-cta text-white' },
];
const linkStyle =
  '[&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_a]:decoration-accent [&_a]:decoration-2 [&_a]:underline-offset-4';
---

<!-- Hero: blueprint grid + an open laptop "being diagnosed", with callouts to the repairs -->
<section class="relative isolate overflow-hidden bg-primary text-white">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.09] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:36px_36px] [mask-image:linear-gradient(to_right,transparent,black_45%)]"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute -top-40 -right-40 -z-10 size-[36rem] rounded-full bg-white/[0.06] blur-3xl" aria-hidden="true"></div>
  <div class="container-site grid grid-cols-1 items-center gap-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10 lg:py-20">
    <div>
      <h1 class="font-display text-[2.6rem] leading-[1.02] font-extrabold tracking-[-0.02em] text-white sm:text-6xl xl:text-[4.2rem]">
        {heading}
      </h1>
      <p class="mt-6 max-w-xl text-xl text-white/85">Servicing {site.area}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-13 px-6 text-base sm:text-lg">
          <Phone size={19} aria-hidden="true" /> Call {site.phone.display}
        </a>
        <a href={site.quoteUrl} class="btn-outline-light min-h-13 px-6 text-base sm:text-lg">
          <FileText size={18} aria-hidden="true" /> Get a Quote
        </a>
      </div>
      <div class="mt-12 border-t border-white/15 pt-6">
        <p class="text-sm font-semibold text-white/70">All brands and makes</p>
        <!-- brand logos sliding right-to-left, fading out at the edges -->
        <div class="brand-marquee relative mt-4 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_14%,black_86%,transparent)]">
          <div class="brand-track flex w-max items-center">
            {
              [0, 1].map((copy) => (
                <ul class="flex shrink-0 items-center gap-12 pr-12" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {['acer', 'asus', 'dell', 'lenovo', 'hp', 'sony'].map((b) => (
                    <li class="shrink-0">
                      <img src={`/images/brands/${b}.png`} alt={copy === 0 ? b.toUpperCase() : ''} loading="lazy" class="h-6 w-auto opacity-85 [filter:brightness(0)_invert(1)]" />
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[560px] lg:max-w-none">
      <HeroLaptop />
    </div>
  </div>
</section>

<LaptopExplorer
  repairs={p.repairs}
  extras={[...p.repairs, ...p.more].filter((r) => !['screenrepair', 'keyboard', 'motherbo', 'harddrive', 'dcjack'].includes(r.id))}
/>

<section class="section">
  <div class="container-site grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="min-w-0">
      <!-- Intro -->
      <div class:list={['space-y-4 text-lg leading-relaxed text-slate-600 [&>p:first-child]:text-xl [&>p:first-child]:text-ink', linkStyle]} set:html={p.introHtml} />



      <!-- One "bench card" per repair: the part drawn on a blueprint panel + the WordPress text.
           Panels alternate sides; common signs read like a technician's checklist. -->
      <div class="mt-12 space-y-8">
        {
          p.repairs.map((r, i) => {
            const flip = i % 2 === 1;
            return (
              <article
                id={r.id}
                class:list={[
                  'scroll-mt-28 overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 md:grid',
                  flip ? 'md:grid-cols-[minmax(0,1fr)_230px]' : 'md:grid-cols-[230px_minmax(0,1fr)]',
                ]}
              >
                <div
                  class:list={[
                    'relative isolate flex min-h-52 flex-col justify-between overflow-hidden bg-ink p-5 text-white md:min-h-full',
                    flip && 'md:order-2',
                  ]}
                >
                  <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.08] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:22px_22px]" aria-hidden="true" />
                  <span class="self-start rounded-full bg-white/10 px-3 py-1 font-display text-xs font-bold text-accent">{r.label}</span>
                  <IsoPart part={r.id} class="mx-auto my-6 w-full max-w-[200px] drop-shadow-[0_12px_18px_rgb(0_0_0_/_0.35)]" />
                  <a href={`tel:${site.phone.tel}`} class="inline-flex items-center gap-2 self-start text-sm font-bold text-white/80 hover:text-accent">
                    <Phone size={15} aria-hidden="true" /> {site.phone.display}
                  </a>
                </div>
                <div class:list={['p-6 sm:p-8', flip && 'md:order-1']}>
                  <h2 class="text-2xl font-extrabold sm:text-[1.7rem]">{r.title}</h2>
                  <span class="mt-3 block h-1 w-12 rounded-full bg-accent" aria-hidden="true" />
                  {r.leadHtml && <div class:list={['mt-5 leading-relaxed text-slate-600', linkStyle]} set:html={r.leadHtml} />}
                  {r.signs.length > 0 && (
                    <div class="mt-5 rounded-2xl border-2 border-dashed border-slate-200 p-5">
                      <p class="font-display text-xs font-bold tracking-[0.14em] text-slate-500 uppercase">Common signs</p>
                      <ul class="mt-3 divide-y divide-dashed divide-slate-200">
                        {r.signs.map((s) => (
                          <li class="flex gap-3 py-2.5 text-[15px] leading-snug text-ink">
                            <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded bg-accent text-ink">
                              <Check size={13} stroke-width={3.5} aria-hidden="true" />
                            </span>
                            <span set:html={s} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {r.restHtml && <div class:list={['mt-5 space-y-4 leading-relaxed text-slate-600', linkStyle]} set:html={r.restHtml} />}
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- The other laptop services as mini laptops: icon + title on the "screen", text on the "deck" -->
      {
        p.more.length > 0 && (
          <div class="mt-12 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2">
            {p.more.map((r, i) => {
              const Icon = iconFor[r.id] ?? Laptop;
              const tone = tones[i % 3];
              return (
                <article id={r.id} class="scroll-mt-28">
                  <div class="relative rounded-t-2xl border-[7px] border-b-0 border-ink bg-primary-deep px-5 pt-5 pb-6 text-white">
                    <span class="absolute top-[-4px] left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-white/40" aria-hidden="true" />
                    <span class:list={['grid size-12 place-items-center rounded-xl', tone.chip]}>
                      <Icon size={22} aria-hidden="true" />
                    </span>
                    <h3 class="mt-4 text-xl font-extrabold text-white">{r.label}</h3>
                  </div>
                  <div class="relative -mx-2 rounded-b-2xl bg-white px-7 pt-6 pb-7 shadow-lift ring-1 ring-slate-200">
                    <span class="absolute top-0 left-1/2 h-1.5 w-16 -translate-x-1/2 rounded-b-md bg-slate-200" aria-hidden="true" />
                    <div class:list={['text-[15px] leading-relaxed text-slate-600', linkStyle]} set:html={r.leadHtml} />
                  </div>
                </article>
              );
            })}
          </div>
        )
      }

      <!-- Areas we serve -->
      {
        p.areas.length > 0 && (
          <section class="mt-16" aria-labelledby="areas-title">
            <h2 id="areas-title" class="text-2xl font-extrabold sm:text-3xl">AREAS WE SERVE</h2>
            <div class="mt-6 space-y-6">
              {p.areas.map((g) => (
                <div class="rounded-2xl bg-primary-tint p-6 sm:p-7">
                  <h3 class="flex items-center gap-2 text-lg font-bold">
                    <MapPin size={18} class="text-cta" aria-hidden="true" /> {g.title}
                  </h3>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {g.links.map((l) => (
                      <li>
                        <a href={l.href} class="block rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-ink ring-1 ring-slate-200 transition hover:bg-primary hover:text-white hover:ring-primary">
                          {l.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div>
      <SideCallCard heading="Talk to a local technician" />
    </div>
  </div>
</section>

<CtaBand />

<style>
  .brand-track {
    animation: brand-marquee 22s linear infinite;
  }
  .brand-marquee:hover .brand-track {
    animation-play-state: paused;
  }
  @keyframes brand-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-track { animation: none; }
  }
</style>
