---
/**
 * Line-art scene for the top of the footer, drawn for the North Lakes / Moreton Bay area
 * (left to right): Glass House Mountains, palms, a Queenslander house, North Lakes lake with a
 * sailboat and fountain, the shopping centre, a long bay bridge and a Redcliffe-line train.
 * Pure SVG (no images), so it is sharp at any size and costs almost nothing to load.
 */
---

<div class="pointer-events-none overflow-hidden" aria-hidden="true">
  <svg
    viewBox="0 96 1440 184"
    preserveAspectRatio="xMidYMax slice"
    class="mt-10 block h-28 w-full text-white/25 sm:h-40 lg:h-48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linejoin="round"
    stroke-linecap="round"
  >
    <!-- ground -->
    <path d="M0 270 H1440" />

    <!-- Glass House Mountains -->
    <path d="M10 270 L48 200 L62 214 L92 120 L104 112 L118 150 L136 170 L160 270" />
    <path d="M150 270 L182 196 L192 160 L204 152 L214 176 L240 214 L262 270" />
    <path d="M96 126 L100 160 M196 168 L200 200" stroke-dasharray="3 6" />

    <!-- palms -->
    <g>
      <path d="M300 270 C298 230 302 200 310 172" />
      <path d="M310 172 C290 164 276 170 266 182 M310 172 C318 152 334 148 348 152 M310 172 C330 170 342 182 346 196 M310 172 C300 154 286 150 274 156 M310 172 C304 186 290 196 280 200" />
      <path d="M350 270 C350 240 352 222 358 206" />
      <path d="M358 206 C344 200 334 204 326 214 M358 206 C364 192 376 190 386 194 M358 206 C372 206 380 216 382 226 M358 206 C352 194 342 190 334 194" />
