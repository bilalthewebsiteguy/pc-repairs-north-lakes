---
/**
 * Dark "find your Mac" section for /mac-repair-services/: the WordPress "We Repair All MAC Models:"
 * list as a lineup on three shelves (notebooks, desktops, mini & servers). Every model gets its own
 * small gold-and-white line drawing of that kind of Mac (no logos). A search box lights up the
 * matching models and fades the rest. Without JavaScript it is simply the full lineup.
 * The model names come from src/lib/mac.ts, unchanged (including WordPress spellings).
 */
import FileText from '@lucide/astro/icons/file-text';
import Phone from '@lucide/astro/icons/phone';
import Search from '@lucide/astro/icons/search';
import { site } from '../config/site';
import type { MacBlock } from '../lib/mac';

interface Props {
  block: MacBlock;
}
const { block } = Astro.props;

type Kind = 'air' | 'pro' | 'ibook' | 'powerbook' | 'book' | 'aio' | 'classic' | 'emac' | 'tower' | 'mini' | 'rack';
const plain = (html: string) => html.replace(/<[^>]+>/g, '').trim();
// Which drawing each model gets, from the model's own name
const kindOf = (name: string): Kind =>
  /air/i.test(name) ? 'air'
  : /book pro/i.test(name) ? 'pro'
  : /ibook/i.test(name) ? 'ibook'
  : /powerbook/i.test(name) ? 'powerbook'
  : /book/i.test(name) ? 'book'
  : /mini/i.test(name) ? 'mini'
  : /server|xserve/i.test(name) ? 'rack'
  : /emac/i.test(name) ? 'emac'
  : /power macintosh/i.test(name) ? 'tower'
  : /macintosh/i.test(name) ? 'classic'
  : 'aio';
const shelfOf = (k: Kind) => (['air', 'pro', 'ibook', 'powerbook', 'book'].includes(k) ? 0 : ['mini', 'rack'].includes(k) ? 2 : 1);

const models = block.items.map((html) => {
  const name = plain(html);
  const kind = kindOf(name);
  return { html, name, kind, shelf: shelfOf(kind) };
});
// Short UI labels for the shelves (not page text)
const shelves = ['Notebooks', 'Desktops', 'Mini & servers']
  .map((label, s) => ({ label, items: models.filter((m) => m.shelf === s) }))
  .filter((s) => s.items.length > 0);
---

<section id={block.id} class="relative isolate scroll-mt-28 overflow-hidden bg-ink py-16 text-white sm:py-20 lg:py-24" aria-labelledby={`${block.id}-title`} data-finder>
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07] [background-image:radial-gradient(white_1.2px,transparent_1.2px)] [background-size:22px_22px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-32 -z-10 size-[30rem] rounded-full bg-primary/40 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-32 right-0 -z-10 size-[26rem] rounded-full bg-accent/[0.06] blur-3xl" aria-hidden="true"></div>

  <div class="container-site grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-14">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h3 id={`${block.id}-title`} class="text-3xl font-extrabold text-white sm:text-4xl">{block.title}</h3>
      <span class="mt-4 block h-1 w-14 rounded-full bg-accent" aria-hidden="true"></span>

      <label class="mt-8 block">
        <span class="font-display text-sm font-bold text-white/70">Find your Mac</span>
        <span class="relative mt-2 block">
          <Search size={18} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-accent" aria-hidden="true" />
          <input
            type="search"
            data-finder-input
            placeholder="e.g. Air, Pro, Mini"
            autocomplete="off"
            class="h-13 w-full rounded-xl bg-white/[0.07] pr-4 pl-11 text-base text-white ring-1 ring-white/15 placeholder:text-white/40 focus:bg-white/10 focus:ring-2 focus:ring-accent focus:outline-none"
          />
        </span>
      </label>
      <p class="mt-3 text-sm font-semibold text-white/60" data-finder-count aria-live="polite">{models.length} models</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
        <a href={`tel:${site.phone.tel}`} class="btn-cta min-h-13 px-6">
          <Phone size={18} aria-hidden="true" /> Call {site.phone.display}
        </a>
        <a href={site.quoteUrl} class="btn-outline-light min-h-13 px-6">
          <FileText size={18} aria-hidden="true" /> Get a Quote
        </a>
      </div>
    </div>

    <!-- the lineup: one shelf per family -->
    <div class="space-y-8">
      {
        shelves.map((shelf) => (
          <div>
            <p class="flex items-center gap-3 font-display text-xs font-bold tracking-[0.16em] text-accent uppercase">
              {shelf.label}
              <span class="h-px flex-1 bg-white/10" aria-hidden="true" />
            </p>
            <div class="relative mt-3">
              <ul class="relative grid grid-cols-3 gap-x-3 gap-y-5 sm:gap-x-4 xl:grid-cols-5">
                {shelf.items.map((m) => (
                  <li data-model={m.name.toLowerCase()} class="finder-item group flex flex-col items-center text-center">
                    <span class="finder-stage relative grid h-20 w-full sm:h-26 place-items-end justify-center pb-2" aria-hidden="true">
                      {/* this model's piece of the shelf (pieces join up across the row) */}
                      <span class="absolute -inset-x-2 bottom-0 h-2 rounded-sm bg-white/10 shadow-[0_10px_18px_-8px_rgb(0_0_0_/_0.7)]" />
                      <span class="absolute -inset-x-2 bottom-1.5 h-px bg-accent/40" />
                      <span class="finder-glow absolute bottom-2 left-1/2 h-4 w-24 -translate-x-1/2 rounded-full bg-accent/30 blur-md" />
                      <svg viewBox="0 0 120 84" class="finder-device relative h-[3.9rem] w-auto sm:h-[5.2rem]" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        {m.kind === 'air' && (
                          <g>
                            <path d="M22 14 h76 l-3 50 h-70 z" class="dv-lid" />
                            <path d="M27 19 h66 l-2.6 40 h-60.8 z" class="dv-screen" />
                            <path d="M10 66 h100 l-6 6 h-88 z" class="dv-base" />
                          </g>
                        )}
                        {m.kind === 'pro' && (
                          <g>
                            <rect x="16" y="6" width="88" height="58" rx="4" class="dv-lid" />
                            <rect x="21" y="11" width="78" height="48" rx="2" class="dv-screen" />
                            <path d="M6 66 h108 v3 a4 4 0 0 1 -4 4 h-100 a4 4 0 0 1 -4 -4 z" class="dv-base" />
                            <path d="M50 66 h20 v2 h-20 z" class="dv-gold" />
                          </g>
                        )}
                        {(m.kind === 'book' || m.kind === 'powerbook') && (
                          <g>
                            <rect x="20" y="12" width="80" height="52" rx="4" class="dv-lid" />
                            <rect x="25" y="17" width="70" height="42" rx="2" class="dv-screen" />
                            <path d="M10 66 h100 l-4 7 h-92 z" class="dv-base" />
                            {m.kind === 'powerbook' && <path d="M48 70 h24" class="dv-line" />}
                          </g>
                        )}
                        {m.kind === 'ibook' && (
                          <g>
                            <rect x="20" y="12" width="80" height="52" rx="12" class="dv-lid" />
                            <rect x="28" y="19" width="64" height="38" rx="4" class="dv-screen" />
                            <path d="M10 66 h100 a0 0 0 0 1 0 0 l-2 4 a6 6 0 0 1 -5 3 h-86 a6 6 0 0 1 -5 -3 z" class="dv-base" />
                            <path d="M56 9 a4 4 0 0 1 8 0" class="dv-line" />
                          </g>
                        )}
                        {m.kind === 'aio' && (
                          <g>
                            <rect x="18" y="4" width="84" height="56" rx="5" class="dv-lid" />
                            <rect x="23" y="9" width="74" height="42" rx="2" class="dv-screen" />
                            <path d="M52 60 l-4 14 h24 l-4 -14" class="dv-base" />
                            <path d="M40 76 h40" class="dv-line" />
                          </g>
                        )}
                        {m.kind === 'classic' && (
                          <g>
                            <path d="M34 6 h52 a4 4 0 0 1 4 4 v62 h-60 v-62 a4 4 0 0 1 4 -4 z" class="dv-lid" />
                            <rect x="40" y="13" width="40" height="30" rx="3" class="dv-screen" />
                            <path d="M62 56 h16" class="dv-line" />
                            <path d="M30 72 h60 v4 h-60 z" class="dv-base" />
                            <circle cx="42" cy="62" r="1.8" class="dv-gold" />
                          </g>
                        )}
                        {m.kind === 'emac' && (
                          <g>
                            <path d="M26 6 h68 a8 8 0 0 1 8 8 v44 q0 10 -10 12 h-64 q-10 -2 -10 -12 v-44 a8 8 0 0 1 8 -8 z" class="dv-lid" />
                            <rect x="34" y="13" width="52" height="38" rx="4" class="dv-screen" />
                            <path d="M44 70 l-4 8 h40 l-4 -8" class="dv-base" />
                          </g>
                        )}
                        {m.kind === 'tower' && (
                          <g>
                            <rect x="36" y="4" width="48" height="74" rx="5" class="dv-lid" />
                            <rect x="42" y="10" width="36" height="8" rx="2" class="dv-screen" />
                            <rect x="42" y="22" width="36" height="6" rx="2" class="dv-screen" />
                            <path d="M46 40 h28 M46 46 h28 M46 52 h28 M46 58 h28" class="dv-line" />
                            <circle cx="60" cy="68" r="3" class="dv-gold" />
                            <path d="M38 78 v3 M82 78 v3" class="dv-line" />
                          </g>
                        )}
                        {m.kind === 'mini' && (
                          <g>
                            <path d="M22 52 l38 -14 l38 14 l-38 14 z" class="dv-lid" />
                            <path d="M22 52 v8 l38 14 v-8 z" class="dv-base" />
                            <path d="M98 52 v8 l-38 14 v-8 z" class="dv-side" />
                            <circle cx="60" cy="52" r="5" class="dv-screen" />
                            <circle cx="88" cy="62" r="1.6" class="dv-gold" />
                          </g>
                        )}
                        {m.kind === 'rack' && (
                          <g>
                            <rect x="8" y="30" width="104" height="18" rx="3" class="dv-lid" />
                            <rect x="8" y="52" width="104" height="18" rx="3" class="dv-lid" />
                            {[0, 1, 2, 3].map((k) => (
                              <rect x={14 + k * 18} y="34" width="14" height="10" rx="1.5" class="dv-screen" />
                            ))}
                            {[0, 1, 2, 3].map((k) => (
                              <rect x={14 + k * 18} y="56" width="14" height="10" rx="1.5" class="dv-screen" />
                            ))}
                            <circle cx="100" cy="39" r="2" class="dv-gold dv-blink" />
                            <circle cx="100" cy="61" r="2" class="dv-gold dv-blink dv-blink-2" />
                            <path d="M88 39 h4 M88 61 h4" class="dv-line" />
                          </g>
                        )}
                      </svg>
                    </span>
                    <span class="finder-name mt-2 font-display text-[12px] leading-snug font-extrabold text-white sm:text-sm" set:html={m.html} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* device drawings */
  .finder-device .dv-lid {
    fill: color-mix(in oklab, var(--brand-ink), var(--brand-primary) 30%);
    stroke: rgb(255 255 255 / 0.8);
    stroke-width: 1.8;
  }
  .finder-device .dv-screen {
    fill: color-mix(in oklab, var(--brand-ink), black 25%);
    stroke: color-mix(in oklab, var(--brand-accent), transparent 35%);
    stroke-width: 1.4;
    transition: fill 0.3s;
  }
  .finder-device .dv-base {
    fill: color-mix(in oklab, var(--brand-primary), black 15%);
    stroke: rgb(255 255 255 / 0.8);
    stroke-width: 1.8;
  }
  .finder-device .dv-side {
    fill: color-mix(in oklab, var(--brand-primary), black 40%);
    stroke: rgb(255 255 255 / 0.8);
    stroke-width: 1.8;
  }
  .finder-device .dv-line {
    stroke: rgb(255 255 255 / 0.45);
    stroke-width: 1.6;
  }
  .finder-device .dv-gold {
    fill: var(--brand-accent);
  }
  .finder-device .dv-blink {
    animation: dv-blink 1.6s steps(2) infinite;
  }
  .finder-device .dv-blink-2 {
    animation-delay: -0.8s;
  }
  @keyframes dv-blink {
    50% { opacity: 0.25; }
  }

  /* lift + glowing screen on hover, focus or a search hit */
  .finder-device {
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .finder-glow {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .finder-name {
    transition: color 0.3s;
  }
  .finder-item:hover .finder-device,
  .finder-item.is-hit .finder-device {
    transform: translateY(-6px);
  }
  .finder-item:hover .finder-glow,
  .finder-item.is-hit .finder-glow {
    opacity: 1;
  }
  .finder-item:hover .dv-screen,
  .finder-item.is-hit .dv-screen {
    fill: color-mix(in oklab, var(--brand-accent), var(--brand-ink) 55%);
  }
  .finder-item.is-hit .finder-name {
    color: var(--brand-accent);
  }
  .finder-item {
    transition: opacity 0.3s, filter 0.3s;
  }
  .finder-item.is-dim {
    opacity: 0.25;
    filter: grayscale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .finder-device,
    .finder-item {
      transition: none;
    }
    .finder-item:hover .finder-device,
    .finder-item.is-hit .finder-device {
      transform: none;
    }
    .finder-device .dv-blink {
      animation: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-finder]')) {
    const input = root.querySelector<HTMLInputElement>('[data-finder-input]');
    const count = root.querySelector<HTMLElement>('[data-finder-count]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-model]')];
    const total = items.length;
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let hits = 0;
      for (const it of items) {
        const hit = !!q && it.dataset.model!.includes(q);
        if (hit) hits++;
        it.classList.toggle('is-hit', hit);
        it.classList.toggle('is-dim', !!q && !hit);
      }
      if (count) {
        count.textContent = !q ? `${total} models` : hits ? `${hits} of ${total} models` : 'No match. Give us a call and ask.';
      }
    });
  }
</script>
